@model IEnumerable<BicoTucano.Models.Cartao>
<!--inject: pega o cliente logado-->
@inject LoginCliente _loginCliente
@{
    ViewData["Title"] = "Meus cartões";
    ViewData["LarguraTotal"] = true;

    Cliente cliente = _loginCliente.GetCliente();
}

<link rel="stylesheet" href="~/css/MeusCartoes.css" asp-append-version="true" />

<div class="pagina">
    <div class="conteudo">

        <div class="menu">
            <div class="menu-perfil">
                <strong>@cliente.Nome</strong>
                <small>@cliente.Email</small>
            </div>

            <a href="#" class="menu-link">Meu perfil</a>
            <a href="#" class="menu-link">Meus pedidos</a>
            <a asp-controller="Cartao" asp-action="Index" class="menu-link ativo">Meus cartões</a>
            <a asp-controller="Home" asp-action="LogoutCliente" class="menu-link sair">Sair</a>
        </div>

        <div class="cartões">
            <h1>Meus cartões</h1>

            @if (TempData["MSG_S"] != null)
            {
                <div class="alert alert-success">@TempData["MSG_S"]</div>
            }
            @if (TempData["MSG_E"] != null)
            {
                <div class="alert alert-danger">@TempData["MSG_E"]</div>
            }

            @if (!Model.Any())
            {
                <p>Você ainda não cadastrou nenhum cartão.</p>
            }

            <div class="formulario">
                <h2>Adicionar novo cartão</h2>

                <form asp-action="Cadastrar" method="post">
                    <input type="hidden" name="Apelido" value="Meu cartão" />

                    <label for="NumeroCartao">Número do cartão</label>
                    <input type="text" name="NumeroCartao" id="NumeroCartao"
                           placeholder="0000 0000 0000 0000" maxlength="23" minlength="16" required />

                    <label for="validade">Validade</label>
                    <input type="text" name="validade" id="validade"
                           class="curto" placeholder="MM/AA" maxlength="5" required />

                    <label for="NomeTitular">Nome do cartão</label>
                    <input type="text" name="NomeTitular" id="NomeTitular"
                           placeholder="Como aparece no cartão" maxlength="30" required />

                    <div class="botoes">
                        <a asp-action="Index" class="btn-cancelar">Cancelar</a>
                        <button type="submit" class="btn-salvar">Salvar Cartão</button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/Cartao.js" asp-append-version="true"></script>
}
