@model BicoTucano.Models.Cliente
@using BicoTucano.Models

@{
    ViewBag.Title = "Modificar Perfil";
    ViewData["LarguraTotal"] = true;

    var cliente = (Cliente)ViewBag.Cliente;
}

<link rel="stylesheet" href="~/css/MenuPerfil.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/FormPerfil.css" asp-append-version="true" />

<section class="perfil-pagina">

    <aside class="perfil-menu">
        <div class="perfil-menu-topo">
            <div class="perfil-foto" aria-hidden="true">@cliente.Nome.Substring(0, 1)</div>
            <strong>@cliente.Nome</strong>
            <small>@cliente.Email</small>
        </div>

        <nav aria-label="Perfil">
            <a asp-controller="Home" asp-action="Perfil" class="perfil-menu-link perfil-menu-link-ativo">Meu Perfil</a>
            <a asp-controller="Pedido" asp-action="MeusPedidos" class="perfil-menu-link">Meus Pedidos</a>
            <a asp-controller="Cartao" asp-action="Index" class="perfil-menu-link">Meus Cartões</a>
            <a asp-controller="Home" asp-action="LogoutCliente" class="perfil-menu-link perfil-menu-link-sair">Sair</a>
        </nav>
    </aside>

    <div class="perfil-principal">

        <h1 class="perfil-titulo">Modificar perfil</h1>

        @if (ViewData["MSG_E"] != null)
        {
            <p class="form-aviso form-aviso-erro">@ViewData["MSG_E"]</p>
        }

        <form asp-action="EditarPerfil" method="post" class="form-card">
            <div asp-validation-summary="ModelOnly" class="erro"></div>

            <h2 class="form-card-titulo">Dados pessoais</h2>

            <div class="linha">
                <div class="campo">
                    <label asp-for="Nome"></label>
                    <input asp-for="Nome" />
                    <span asp-validation-for="Nome" class="erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" />
                    <span asp-validation-for="Email" class="erro"></span>
                </div>
            </div>

            <div class="linha">
                <div class="campo">
                    <label asp-for="DataNasc"></label>
                    <input asp-for="DataNasc" type="date" value="@(Model.DataNasc.HasValue ? Model.DataNasc.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="DataNasc" class="erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="Sexo"></label>
                    <select asp-for="Sexo">
                        <option value="M">Masculino</option>
                        <option value="F">Feminino</option>
                    </select>
                    <span asp-validation-for="Sexo" class="erro"></span>
                </div>
            </div>

            <div class="linha">
                <div class="campo">
                    <label asp-for="Telefone"></label>
                    <input asp-for="Telefone" type="text" placeholder="11999999999" />
                    <span asp-validation-for="Telefone" class="erro"></span>
                </div>

                <div class="campo">
                    <label asp-for="CPF"></label>
                    <input asp-for="CPF" />
                    <span asp-validation-for="CPF" class="erro"></span>
                </div>
            </div>

            <div class="form-botoes">
                <a class="form-botao form-botao-cancelar" asp-action="Perfil">Cancelar</a>
                <button type="submit" class="form-botao">Salvar</button>
            </div>
        </form>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}