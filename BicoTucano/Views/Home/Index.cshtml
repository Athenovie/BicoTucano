@{
    ViewData["Title"] = "Home";
}
<div class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <p class="laranja mb-2"><b>--- 100% VEGANO & NATURAL</b></p>
                <h1>Comer bem é um ato de <span class="verde">memória</span></h1>
                <p>Pratos elaborados com ingredientes frescos e sazonais, sem conservantes, com todo o cuidado que a natureza merece.</p>

                <div class="row mt-4">
                    <div class="col-4">
                        <h4 class="text-white">1.2K+</h4>
                        <small class="text-white-50">Clientes felizes</small>
                    </div>
                    <div class="col-4">
                        <h4 class="text-white">48</h4>
                        <small class="text-white-50">Pratos no cardápio</small>
                    </div>
                    <div class="col-4">
                        <h4 class="text-white">4.9</h4>
                        <small class="text-white-50">Avaliação média</small>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="hero-mini-card d-flex justify-content-between align-items-center">
                    <div>
                        <p><b>Burguer Vegano Artesanal</b></p>
                        <small>R$ 24,90</small>
                    </div>
                    <button type="button" class="btn-mais">+</button>
                </div>
                <div class="hero-mini-card d-flex justify-content-between align-items-center">
                    <div>
                        <p><b>Bowl Fit com Quinoa</b></p>
                        <small>R$ 28,90</small>
                    </div>
                    <button type="button" class="btn-mais">+</button>
                </div>
                <div class="hero-mini-card d-flex justify-content-between align-items-center">
                    <div>
                        <p><b>Suco Detox Verde</b></p>
                        <small>R$ 12,90</small>
                    </div>
                    <button type="button" class="btn-mais">+</button>
                </div>
            </div>
        </div>
    </div>
</div>