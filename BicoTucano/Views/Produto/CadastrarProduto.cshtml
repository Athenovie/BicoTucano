@model BicoTucano.Models.Produto

@{
    ViewData["Title"] = "CadadastarProduto";
}

<h1>Cadastrar Produto</h1>

<h4>Produto</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Cadastrar" asp-controller="Produto" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input asp-for="ID_Produto" type="hidden" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Disponibilidade" class="control-label"></label>
                <input asp-for="Disponibilidade" type="checkbox" />
                <span asp-validation-for="Disponibilidade" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ID_Categoria" class="control-label">Categoria</label>
                <input asp-for="ID_Categoria" class="form-control" />
                <span asp-validation-for="ID_Categoria" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="file" name="file" id="file" />
                <span asp-validation-for="NomeImagem" class="text-danger"></span>
            </div>

            @ViewBag.msg

            <br />

            <div class="form-group">
                <input type="submit" value="Cadastrar" class="btn btn-success" />
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
