@model BicoTucano.Models.Produto

@{
    ViewData["Title"] = Model.Nome;
    ViewData["LarguraTotal"] = true;
    var disponivel = Model.Disponibilidade;
}

<link rel="stylesheet" href="~/css/Detalhes.css" asp-append-version="true" />

<section class="detalhe-produto">

    <img src="~/img/@Model.NomeImagem"
         alt="@Model.Nome"
         class="detalhe-imagem" />

    <div class="detalhe-info">

        <span class="detalhe-categoria">@Model.Categoria</span>

        <h1 class="detalhe-nome">@Model.Nome</h1>

        <span class="detalhe-disponibilidade @(disponivel ? "disponivel" : "indisponivel")">
            @(disponivel ? "Disponível" : "Indisponível")
        </span>

        <p class="detalhe-preco">R$ @Model.Preco.ToString("F2")</p>

        <p class="detalhe-descricao">@Model.Descricao</p>

        <form asp-controller="Pedido" asp-action="AdicionarItem" asp-route-id="@Model.ID_Produto"
              method="post" class="detalhe-compra">

            <div class="detalhe-quantidade">
                <button type="button" id="botao-menos" class="botao-quantidade" aria-label="Diminuir quantidade">−</button>
                <input type="number" id="campo-quantidade" name="quantidade" value="1" min="1" max="99" aria-label="Quantidade" />
                <button type="button" id="botao-mais" class="botao-quantidade" aria-label="Aumentar quantidade">+</button>
            </div>

            <button type="submit" class="botao-carrinho" disabled="@(!disponivel)">
                Adicionar ao carrinho
            </button>

        </form>

    </div>

</section>


<section class="secao-produtos">

    <h3>Você também vai gostar</h3>
    <h2>Produtos Relacionados</h2>

    <div class="lista-produtos">

        <a asp-controller="Produto" asp-action="Detalhes" asp-route-id="@ViewBag.ProdutosRelacionados[0].ID_Produto" class="card-produto">
            <img src="~/img/@ViewBag.ProdutosRelacionados[0].NomeImagem" />
            <h3>@ViewBag.ProdutosRelacionados[0].Nome</h3>
            <p class="descricao-produto">@ViewBag.ProdutosRelacionados[0].Descricao</p>
            <div class="rodape-produto">
                <div class="preco-produto">
                    <small>a partir de</small>
                    <strong>R$ @ViewBag.ProdutosRelacionados[0].Preco.ToString("F2")</strong>
                </div>
                <button type="submit" class="botao-adicionar" disabled="@(!disponivel)">
                    Adicionar
                </button>
            </div>
        </a>

        <a asp-controller="Produto" asp-action="Detalhes" asp-route-id="@ViewBag.ProdutosRelacionados[1].ID_Produto" class="card-produto">
            <img src="~/img/@ViewBag.ProdutosRelacionados[1].NomeImagem" />
            <h3>@ViewBag.ProdutosRelacionados[1].Nome</h3>
            <p class="descricao-produto">@ViewBag.ProdutosRelacionados[1].Descricao</p>
            <div class="rodape-produto">
                <div class="preco-produto">
                    <small>a partir de</small>
                    <strong>R$ @ViewBag.ProdutosRelacionados[1].Preco.ToString("F2")</strong>
                </div>
                <button type="submit" class="botao-adicionar" disabled="@(!disponivel)">
                    Adicionar
                </button>
            </div>
        </a>

        <a asp-controller="Produto" asp-action="Detalhes" asp-route-id="@ViewBag.ProdutosRelacionados[2].ID_Produto" class="card-produto">
            <img src="~/img/@ViewBag.ProdutosRelacionados[2].NomeImagem" />
            <h3>@ViewBag.ProdutosRelacionados[2].Nome</h3>
            <p class="descricao-produto">@ViewBag.ProdutosRelacionados[2].Descricao</p>
            <div class="rodape-produto">
                <div class="preco-produto">
                    <small>a partir de</small>
                    <strong>R$ @ViewBag.ProdutosRelacionados[2].Preco.ToString("F2")</strong>
                </div>
                <button type="submit" class="botao-adicionar" disabled="@(!disponivel)">
                    Adicionar
                </button>
            </div>
        </a>

    </div>

</section>


@section Scripts {
    <script>
        const campo = document.getElementById('campo-quantidade');

        document.getElementById('botao-menos').addEventListener('click', () => {
            campo.value = Math.max(1, (parseInt(campo.value) || 1) - 1);
        });

        document.getElementById('botao-mais').addEventListener('click', () => {
            campo.value = Math.min(99, (parseInt(campo.value) || 1) + 1);
        });
    </script>
}
