@model BicoTucano.Models.Pedido
@using System.Globalization
@{
    ViewData["Title"] = "Pedido confirmado";
    ViewData["LarguraTotal"] = true;
    var br = new CultureInfo("pt-BR");
    
    string status = "";
    if (Model.StatusPedido == StatusPedido.EmPreparo)
    {
        status = "Em preparo";
    }
    else if (Model.StatusPedido == StatusPedido.EmEntrega)
    {
        status = "A caminho";
    }
    else
    {
        status = "Concluído";
    }
}
<!-- Criei a variável status do tipo string vazia que vai se preenchida quando a condicional for verificada-->
<link rel="stylesheet" href="~/css/Confirmacao.css" asp-append-version="true" />

<section class="pagina-confirmacao">
    <div class="icone-check">✓</div>

    <h1>Pedido Confirmado!</h1>
    <p class="mensagem">Seu pagamento foi aprovado. Seu pedido já está sendo preparado com carinho e chegará em breve!</p>

    <div class="card-pedido">
        <div class="linha">
            <span>Nº do pedido</span>
            <strong>#VN-@Model.NF.ToString("D7")</strong>
        </div>
        <div class="linha">
            <span>Total Pago</span>
            <strong>@Model.ValorTotal.ToString("C", br)</strong>
        </div>
        <div class="linha">
            @if (Model.TipoPedido == TipoPedido.Entrega)
            {
                <span>Previsão de entrega</span>
                <strong>~ 35min</strong>
            }
            else
            {
                <span>Retirada</span>
                <strong>No restaurante</strong>
            }
        </div>
        <div class="linha">
            <span>Status</span>
            <strong>@status</strong>
        </div>
    </div>

    <div class="botoes">
        <a class="botao-verde" asp-controller="Pedido" asp-action="Confirmacao" asp-route-id="@Model.NF">Ver meus pedidos</a>
        <a class="botao-laranja" asp-controller="Home" asp-action="Index">Voltar ao Menu</a>
    </div>
</section>