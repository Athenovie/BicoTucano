@model BicoTucano.Models.Pedido
@using System.Globalization

@{
    ViewData["Title"] = "Pedido confirmado";
    ViewData["LarguraTotal"] = true;

    var br = new CultureInfo("pt-BR");

    string status;
    if (Model.StatusPedido == StatusPedido.EmPreparo)
        status = "Em preparo";
    else if (Model.StatusPedido == StatusPedido.EmEntrega)
        status = "A caminho";
    else
        status = "Concluído";
}

<link rel="stylesheet" href="~/css/Confirmacao.css" asp-append-version="true" />

<section class="pagina-confirmacao">

    <div class="confirmacao-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor"
             stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
    </div>

    <h1 class="confirmacao-titulo">Pedido Confirmado!</h1>

    <p class="confirmacao-mensagem">
        Seu pagamento foi aprovado. Seu pedido já está sendo preparado com carinho e chegará em breve!
    </p>

    <div class="confirmacao-card">
        <div class="confirmacao-linha">
            <span>Nº do pedido</span>
            <strong>#VN-@Model.NF.ToString("D7")</strong>
        </div>

        <div class="confirmacao-linha">
            <span>Total Pago</span>
            <strong>@Model.ValorTotal.ToString("C", br)</strong>
        </div>

        <div class="confirmacao-linha">
            @if (Model.TipoPedido == TipoPedido.Entrega)
            {
                <span>Previsão de entrega</span>
                <strong>~ 35min</strong>
            }
            else
            {
                <span>Retirada</span>
                <strong>No restaurante</strong>
            }
        </div>

        <div class="confirmacao-linha">
            <span>Status</span>
            <strong>@status</strong>
        </div>
    </div>

    <div class="confirmacao-botoes">
        <a class="confirmacao-botao confirmacao-botao-verde" asp-controller="Pedido" asp-action="MeusPedidos">Ver meus pedidos</a>
        <a class="confirmacao-botao confirmacao-botao-laranja" asp-controller="Home" asp-action="Index">Voltar ao Menu</a>
    </div>

</section>