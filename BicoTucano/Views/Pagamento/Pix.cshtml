@model BicoTucano.Models.Pedido
@{
    ViewData["Title"] = "Pagamento com Pix";
    ViewData["LarguraTotal"] = true;
}

<link rel="stylesheet" href="~/css/PagamentoPix.css" asp-append-version="true" />

<section class="pagina-pix">
    <p class="aviso">Falta pouco! Confirme o pagamento para finalizar o seu pedido.</p>

    <h1>Pagamento com Pix</h1>

    <div class="qr">
        <div class="qr-quadrado"></div>
    </div>

    <div class="codigo" id="codigo">@ViewBag.CodigoPix</div>

    <button type="button" class="botao-verde" id="copiar">Copiar código Pix</button>

    <p class="prazo">*O pagamento deve ser efetuado em até 50 minutos</p>

    <div class="botoes">
        <form asp-action="ConfirmarPix" method="post">
            <button type="submit" class="botao-laranja">Confirmar pagamento</button>
        </form>
        <a class="voltar" asp-controller="Home" asp-action="Index">Voltar para o menu</a>
    </div>
</section>

@section Scripts {
    <script>
        const botao = document.getElementById("copiar");
        const codigo = document.getElementById("codigo");

        if (botao && codigo) {
            botao.addEventListener("click", function () {
                navigator.clipboard.writeText(codigo.innerText);
                botao.innerText = "Código copiado!";
            });
        }
    </script>
}