@model BicoTucano.Models.Pedido
@using System.Globalization
@{
    ViewData["Title"] = "Pagamento";
    ViewData["LarguraTotal"] = true;

    var br = new CultureInfo("pt-BR");
    var cartoes = (List<Cartao>)ViewBag.Cartoes;

    object? formaObj = ViewBag.FormaSelecionada;
    FormaPagamento formaSelecionada = formaObj is FormaPagamento forma ? forma : FormaPagamento.CartaoCredito;

    object? cartaoObj = ViewBag.CartaoSelecionado;
    int cartaoSelecionado = cartaoObj is int idCartao ? idCartao : 0;
}

<link rel="stylesheet" href="~/css/Pagamento.css" asp-append-version="true" />

<section class="pagina-pagamento">
    <h1>Pagamento</h1>
    <p class="subtitulo">Pedido nº @Model.NF - total de @Model.ValorTotal.ToString("C", br)</p>

    @if (ViewBag.Erro != null)
    {
        <div class="mensagem-erro">@ViewBag.Erro</div>
    }

    <div class="cards">

        <div class="card-pagamento">
            <h2>Pix</h2>
            <form asp-action="PagarPix" asp-route-id="@Model.NF" method="post">
                <p>Você recebe um código "copia e cola" para pagar no app do seu banco.</p>
                <div class="botao-area">
                    <button type="submit" class="botao-verde">Pagar com Pix</button>
                </div>
            </form>
        </div>

        <div class="card-pagamento">
            <h2>Cartão</h2>
        <!--Criando estruturas de condição caso usuário tenha ou não o cartão-->
            @if (cartoes.Count == 0)
            {
                <p>Você ainda não tem cartão cadastrado.</p>
                <div class="botao-area">
                    <a class="botao-laranja" asp-controller="Cartao" asp-action="Cadastrar" asp-route-nf="@Model.NF">Cadastrar Cartão</a>
                </div>
            }
            else
            {
                <form asp-action="PagarCartao" asp-route-id="@Model.NF" method="post">
                    <div>
                        <label><input type="radio" name="forma" value="@FormaPagamento.CartaoCredito" checked="@(formaSelecionada != FormaPagamento.CartaoDebito)" /> Crédito</label>
                        <label><input type="radio" name="forma" value="@FormaPagamento.CartaoDebito" checked="@(formaSelecionada == FormaPagamento.CartaoDebito)" /> Débito</label>
                    </div>

                    @foreach (Cartao c in cartoes)
                    {
                        bool vencido = c.DataValidade.Date < DateTime.Today;
                        <label class="opcao-cartao">
                            <input type="radio" name="idCartao" value="@c.ID_Cartao" disabled="@vencido" checked="@(cartaoSelecionado == c.ID_Cartao)" />
                            @c.Apelido - @c.NumeroCartao (@c.DataValidade.ToString("MM/yy"))
                            @if (vencido)
                            {
                                <span class="vencido">Vencido</span>
                            }
                        </label>
                    }

                    <input type="password" name="cvv" class="campo-cvv" maxlength="4" placeholder="CVV" />

                    <div class="botao-area">
                        <button type="submit" class="botao-verde">Pagar @Model.ValorTotal.ToString("C", br)</button>
                    </div>
                </form>
            }
        </div>

    </div>
</section>