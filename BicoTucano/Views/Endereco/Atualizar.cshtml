@model BicoTucano.Models.Endereco
@{
    ViewData["Title"] = "Atualizar endereço";
}

<h1>Atualizar endereço</h1>


<form asp-action="Atualizar" method="post" class="col-md-6 p-0">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="ID_UsuarioEndereco" />
    <input type="hidden" asp-for="ID_Usuario" />

    <partial name="_Form" model="Model" />

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/endereco.js" asp-append-version="true"></script>
}
