@model BicoTucano.Models.Endereco
@using BicoTucano.Models

@{
    ViewData["Title"] = "Editar endereço";
    ViewData["LarguraTotal"] = true;

    var cliente = (Cliente)ViewBag.Cliente;
}

<link rel="stylesheet" href="~/css/MenuPerfil.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/FormPerfil.css" asp-append-version="true" />

<section class="perfil-pagina">

    <aside class="perfil-menu">
        <div class="perfil-menu-topo">
            <div class="perfil-foto" aria-hidden="true">@cliente.Nome.Substring(0, 1)</div>
            <strong>@cliente.Nome</strong>
            <small>@cliente.Email</small>
        </div>

        <nav aria-label="Perfil">
            <a asp-controller="Home" asp-action="Perfil" class="perfil-menu-link perfil-menu-link-ativo">Meu Perfil</a>
            <a asp-controller="Pedido" asp-action="MeusPedidos" class="perfil-menu-link">Meus Pedidos</a>
            <a asp-controller="Cartao" asp-action="Index" class="perfil-menu-link">Meus Cartões</a>
            <a asp-controller="Home" asp-action="LogoutCliente" class="perfil-menu-link perfil-menu-link-sair">Sair</a>
        </nav>
    </aside>

    <div class="perfil-principal">

        <h1 class="perfil-titulo">Editar endereço</h1>

        <form asp-action="Atualizar" method="post" class="form-card">
            <input type="hidden" asp-for="ID_UsuarioEndereco" />
            <input type="hidden" asp-for="ID_Usuario" />

            <partial name="_Form" model="Model" />

            <div class="form-botoes">
                <a class="form-botao form-botao-cancelar" asp-controller="Home" asp-action="Perfil">Cancelar</a>
                <button type="submit" class="form-botao">Salvar</button>
            </div>
        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/endereco.js" asp-append-version="true"></script>
}
