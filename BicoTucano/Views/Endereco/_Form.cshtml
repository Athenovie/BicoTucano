@model BicoTucano.Models.Endereco

<div asp-validation-summary="ModelOnly" class="erro"></div>

<div class="campo metade">
    <label asp-for="NomeEndereco"></label>
    <input asp-for="NomeEndereco" placeholder="Ex.: Casa, Trabalho" />
    <span asp-validation-for="NomeEndereco" class="erro"></span>
</div>

<div class="campo metade">
    <label asp-for="CEP"></label>
    <input asp-for="CEP" class="CEP" placeholder="00000-000" maxlength="9" />
    <span asp-validation-for="CEP" class="erro"></span>
</div>

<div class="linha">
    <div class="campo">
        <label asp-for="Estado"></label>
        <input asp-for="Estado" maxlength="2" placeholder="SP" />
        <span asp-validation-for="Estado" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="Cidade"></label>
        <input asp-for="Cidade" />
        <span asp-validation-for="Cidade" class="erro"></span>
    </div>
</div>

<div class="campo">
    <label asp-for="Logradouro"></label>
    <input asp-for="Logradouro" />
    <span asp-validation-for="Logradouro" class="erro"></span>
</div>

<div class="linha">
    <div class="campo">
        <label asp-for="Bairro"></label>
        <input asp-for="Bairro" />
        <span asp-validation-for="Bairro" class="erro"></span>
    </div>

    <div class="campo">
        <label asp-for="Numero"></label>
        <input asp-for="Numero" placeholder="Nº" />
        <span asp-validation-for="Numero" class="erro"></span>
    </div>
</div>

<div class="campo">
    <label asp-for="Complemento"></label>
    <input asp-for="Complemento" placeholder="Bloco, Apto" />
    <span asp-validation-for="Complemento" class="erro"></span>
</div>
