@model BicoTucano.Models.Pedido
@using BicoTucano.Models

@{
    ViewBag.Title = "Detalhes do Pedido";
    var pt = new System.Globalization.CultureInfo("pt-BR");
    var itens = (List<Item_Pedido>)ViewBag.Itens;
    var produtos = (Dictionary<int, Produto>)ViewBag.Produtos;
    var pagamento = ViewBag.Pagamento as Pagamento;
    var cartao = ViewBag.Cartao as Cartao;

    // etapa atual: 1 = em preparo, 2 = em entrega, 3 = concluído
    int etapa = (int)Model.StatusPedido;

    string metodo = "Não informado";
    if (pagamento != null)
    {
        if (pagamento.FormaPagamento == FormaPagamento.Pix)
        {
            metodo = "Pix";
        }
        else if (cartao != null)
        {
            string numero = cartao.NumeroCartao;
            string final = numero.Length >= 4 ? numero.Substring(numero.Length - 4) : numero;
            metodo = "Cartão •••• " + final;
        }
        else
        {
            metodo = "Cartão";
        }
    }
}

<div class="container mt-4">

    <a asp-action="MeusPedidos" class="text-muted">← Meus pedidos</a>
    <h2>DETALHES DO PEDIDO</h2>

    <!-- Número e andamento -->
    <div class="card p-3 mb-3">
        <small class="text-muted">Nº DO PEDIDO</small>
        <h5>#@Model.NF</h5>

        <div class="d-flex justify-content-between text-center mt-2">
            <div style="color:@(etapa >= 1 ? "#4a7c59" : "#aaa");">
                <strong>@(etapa >= 1 ? "✔" : "○")</strong><br />Em preparo
            </div>
            <div style="color:@(etapa >= 2 ? "#4a7c59" : "#aaa");">
                <strong>@(etapa >= 2 ? "✔" : "○")</strong><br />Em entrega
            </div>
            <div style="color:@(etapa >= 3 ? "#4a7c59" : "#aaa");">
                <strong>@(etapa >= 3 ? "✔" : "○")</strong><br />Concluído
            </div>
        </div>
    </div>

    <div class="row">

        <!-- Itens -->
        <div class="col-md-8">
            <div class="card p-3 mb-3">
                <h6>Itens do pedido</h6>

                @foreach (var item in itens)
                {
                    var produto = produtos[item.ID_Produto];

                    <div class="d-flex align-items-center border-bottom py-2">
                        <img src="~/img/@produto.NomeImagem" style="width:50px; height:50px; object-fit:cover; border-radius:8px;" class="mr-3 me-3" />
                        <div class="flex-grow-1">
                            <strong>@produto.Nome</strong><br />
                            <small class="text-muted">x@(item.Quantidade)</small>
                        </div>
                        <strong>R$ @((item.Preco * item.Quantidade).ToString("N2", pt))</strong>
                    </div>
                }
            </div>

            <!-- Endereço -->
            @if (Model.TipoPedido == TipoPedido.Entrega)
            {
                <div class="card p-3 mb-3">
                    <h6>Endereço de entrega</h6>
                    <div class="row">
                        <div class="col-6"><small class="text-muted">CEP</small><br />@Model.CEP</div>
                        <div class="col-6"><small class="text-muted">NÚMERO / COMPLEMENTO</small><br />@Model.DetalhesPedido</div>
                    </div>
                </div>
            }
            else
            {
                <div class="card p-3 mb-3">
                    <h6>Retirada</h6>
                    <p class="mb-0">Retire seu pedido na loja.</p>
                </div>
            }
        </div>

        <!-- Resumo -->
        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <h6>Resumo</h6>

                <div class="d-flex justify-content-between"><span>Subtotal</span><strong>R$ @Model.Subtotal.ToString("N2", pt)</strong></div>
                <div class="d-flex justify-content-between"><span>Entrega</span><strong>R$ @Model.TaxaEntrega.ToString("N2", pt)</strong></div>
                <hr />
                <div class="d-flex justify-content-between"><strong>Total</strong><strong>R$ @Model.ValorTotal.ToString("N2", pt)</strong></div>
                <div class="d-flex justify-content-between mt-2"><span>Pagamento</span><span>@metodo</span></div>
                <div class="d-flex justify-content-between"><span>Data do pedido</span><span>@Model.DataPedido.ToString("dd/MM/yyyy")</span></div>
            </div>
        </div>

    </div>
</div>