@model BicoTucano.Models.Pedido
@using BicoTucano.Models

@{
    ViewBag.Title = "Detalhes do Pedido";
    ViewData["LarguraTotal"] = true;
    var br = new System.Globalization.CultureInfo("pt-BR");
   @*Recebendo os dados do pedido*@
    var itens = (List<Item_Pedido>)ViewBag.Itens;
    var produtos = (Dictionary<int, Produto>)ViewBag.Produtos;
    var pagamento = ViewBag.Pagamento as Pagamento;
    var cartao = ViewBag.Cartao as Cartao;
    var cliente = (Cliente)ViewBag.Cliente;
   @*Verificando status do pedido*@
    bool concluido = Model.StatusPedido == StatusPedido.Concluido;

    string metodo = "Não informado";
    if (pagamento != null)
    {
        if (pagamento.FormaPagamento == FormaPagamento.Pix)
        {
            metodo = "Pix";
        }
        else if (cartao != null)
        {
            string numero = cartao.NumeroCartao;
            string final = numero.Length >= 4 ? numero.Substring(numero.Length - 4) : numero;
            metodo = "Cartão •••• " + final;
        }
        else
        {
            metodo = "Cartão";
        }
    }
}

<link rel="stylesheet" href="~/css/MenuPerfil.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/PedidoDetalhes.css" asp-append-version="true" />

<div class="pagina">
    <div class="conteudo">

        <div class="menu">
            <div class="menu-perfil">
                <div class="foto">@cliente.Nome.Substring(0, 1)</div>
                <strong>@cliente.Nome</strong>
                <small>@cliente.Email</small>
            </div>
            <a asp-controller="Home" asp-action="Perfil" class="menu-link">Meu Perfil</a>
            <a asp-controller="Pedido" asp-action="MeusPedidos" class="menu-link ativo">Meus Pedidos</a>
            <a asp-controller="Cartao" asp-action="Index" class="menu-link">Meus Cartões</a>
            <a href="/Home/LogoutCliente" class="menu-link sair">Sair</a>
        </div>

        <div class="detalhes">
            <a asp-action="MeusPedidos" class="voltar">← Meus pedidos</a>
            <h1>Detalhes do pedido</h1>

            <div class="caixa">
                <div class="numero">
                    <div>
                        <small>Nº DO PEDIDO</small>
                        <h2>#VN-@Model.NF.ToString("D7")</h2>
                    </div>
                    <span class="status">@(concluido ? "Concluído" : "Em andamento")</span>
                </div>
                @*etapa atual: 1 = em preparo, 2 = em entrega, 3 = concluído*@
                <div class="etapas">
                    <div class="etapa">
                        <span class="bolinha verde">✓</span>
                        <strong>Confirmado</strong>
                        <small>@Model.DataPedido.ToString("HH:mm")</small>
                    </div>
                    <div class="etapa">
                        <span class="bolinha verde">✓</span>
                        <strong>Preparando</strong>
                    </div>
                    <div class="etapa">
                        <span class="bolinha @(concluido ? "verde" : "")">@(concluido ? "✓" : "⌂")</span>
                        <strong>Entregue</strong>
                        <small>~@Model.DataPedido.AddMinutes(35).ToString("HH:mm")</small>
                    </div>
                </div>
            </div>

            <div class="conteudo-pedido">
                <div class="informacoes-pedido">
                    <div class="secao-pedido">
                        <h3>Itens do pedido</h3>
                        @foreach (var item in itens)
                        {
                            var produto = produtos[item.ID_Produto];
                            <div class="item">
                                <img src="~/img/@produto.NomeImagem" />
                                <div class="item-nome">
                                    <strong>@produto.Nome</strong>
                                    <small>x@(item.Quantidade)</small>
                                </div>
                                <strong>R$ @((item.Preco * item.Quantidade).ToString("N2", br))</strong>
                            </div>
                        }
                    </div>

                    @if (Model.TipoPedido == TipoPedido.Entrega)
                    {
                        <div class="secao-pedido">
                            <h3>Endereço de entrega</h3>
                            <div class="endereco">
                                <div><small>CEP</small>@Model.CEP</div>
                                <div><small>NÚMERO / COMPLEMENTO</small>@Model.DetalhesPedido</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="secao-pedido">
                            <h3>Retirada</h3>
                            <p>Retire seu pedido na loja.</p>
                        </div>
                    }
                </div>

                <div class="resumo-pedido">
                    <div class="secao-pedido">
                       <h2 class="resumo-titulo">Resumo</h2>

<div class="informacao-resumo">
    <span>Subtotal</span>
    <strong>R$ @Model.Subtotal.ToString("N2", br)</strong>
</div>

<div class="informacao-resumo">
    <span>Entrega</span>
    <strong>R$ @Model.TaxaEntrega.ToString("N2", br)</strong>
</div>

<hr />

<div class="informacao-resumo">
    <strong>Total pago</strong>
    <strong>R$ @Model.ValorTotal.ToString("N2", br)</strong>
</div>

<div class="informacao-resumo">
    <span>Pagamento</span>
    <strong>@metodo</strong>
</div>

<div class="informacao-resumo">
    <span>Data do pedido</span>
    <strong>@Model.DataPedido.ToString("dd/MM/yyyy")</strong>
</div>

<button type="button" class="btn-via" onclick="window.print()"> Segunda via </button>
</div>
                </div>
            </div>
        </div>

    </div>
</div>