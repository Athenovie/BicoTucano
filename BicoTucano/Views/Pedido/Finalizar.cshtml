@model List<BicoTucano.Models.Item_Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Finalizar pedido";
    ViewData["LarguraTotal"] = true;

    var br = new CultureInfo("pt-BR");
    var produtos = (Dictionary<int, Produto>)ViewBag.Produtos;
    var enderecos = (List<Endereco>)ViewBag.Enderecos;
    decimal taxa = (decimal)ViewBag.TaxaEntrega;
    decimal subtotal = Model.Sum(i => i.Preco * i.Quantidade);

    object? tipoObj = ViewBag.TipoSelecionado;
    TipoPedido tipoSelecionado = tipoObj is TipoPedido tipoEscolhido ? tipoEscolhido : TipoPedido.Retirada;

    object? enderecoObj = ViewBag.EnderecoSelecionado;
    int enderecoSelecionado = enderecoObj is int idEscolhido ? idEscolhido : 0;

    string observacao = ViewBag.Observacao as string ?? "";
    bool ehEntrega = tipoSelecionado == TipoPedido.Entrega;

    Usuario cliente = ViewBag.Cliente;
}

<link rel="stylesheet" href="~/css/Finalizar.css" asp-append-version="true" />

<section class="pagina-finalizar">
    <h1 class="finalizar-titulo">Finalizar Pedido</h1>

    @if (ViewBag.Erro != null)
    {
        <div class="finalizar-erro">@ViewBag.Erro</div>
    }

    <div class="finalizar-corpo">
        <div class="finalizar-esquerda">
            <div class="finalizar-caixa">
                <h2 class="finalizar-caixa-titulo">Dados do cliente</h2>

                <div class="finalizar-dados">
                    <div class="finalizar-dado">
                        <span class="finalizar-rotulo">Nome</span>
                        <span>@cliente.Nome</span>
                    </div>
                    <div class="finalizar-dado">
                        <span class="finalizar-rotulo">Telefone</span>
                        <span>@cliente.Telefone</span>
                    </div>
                    <div class="finalizar-dado">
                        <span class="finalizar-rotulo">E-mail</span>
                        <span>@cliente.Email</span>
                    </div>
                </div>

            </div>

            <form asp-action="Finalizar" method="post" class="finalizar-formulario">

                <div class="finalizar-caixa">
                    <h2 class="finalizar-caixa-titulo">Como você quer receber?</h2>

                    <label class="finalizar-opcao" for="tipoRetirada">
                        <input type="radio" name="tipoPedido" id="tipoRetirada"
                               value="@TipoPedido.Retirada" checked="@(!ehEntrega)" />
                        <span>Retirada no restaurante (sem taxa)</span>
                    </label>
                    <label class="finalizar-opcao" for="tipoEntrega">
                        <input type="radio" name="tipoPedido" id="tipoEntrega"
                               value="@TipoPedido.Entrega" checked="@ehEntrega" />
                        <span>Entrega (taxa de @taxa.ToString("C", br))</span>
                    </label>
                </div>

                <div id="blocoEntrega" class="finalizar-caixa @(ehEntrega ? "" : "finalizar-oculto")">
                    @if (enderecos.Count == 0)
                    {
                        <div class="finalizar-aviso">
                            Você ainda não tem endereço cadastrado.
                            <a asp-controller="Endereco" asp-action="Cadastrar">Cadastrar endereço</a>
                        </div>
                    }
                    else
                    {
                        <label for="idEndereco" class="finalizar-caixa-titulo">Endereço de entrega</label>
                        <select name="idEndereco" id="idEndereco" class="finalizar-campo">
                            <option value="">Selecione...</option>
                            @foreach (Endereco e in enderecos)
                            {
                                <option value="@e.ID_UsuarioEndereco" selected="@(enderecoSelecionado == e.ID_UsuarioEndereco)">
                                    @e.NomeEndereco - @e.Logradouro, @e.Numero - @e.Bairro, @e.Cidade/@e.Estado
                                </option>
                            }
                        </select>
                    }
                </div>

                <div class="finalizar-botoes">
                    <label for="observacao" class="finalizar-caixa-titulo">Observação (opcional)</label>
                    <textarea name="observacao" id="observacao" class="finalizar-campo" rows="2"
                              maxlength="80" placeholder="Ex.: sem cebola, ponto da campainha...">@observacao</textarea>
                </div>

                <div class="finalizar-botoes">
                    <a class="finalizar-botao-voltar" asp-action="Carrinho">Voltar ao carrinho</a>
                    <button type="submit" class="finalizar-botao-confirmar">Confirmar pedido</button>
                </div>
                
            </form>
        </div>

        <div class="finalizar-resumo">
            <h2 class="finalizar-resumo-titulo">Resumo</h2>

            @foreach (Item_Pedido item in Model)
            {
                <p class="finalizar-linha">
                    <span>@item.Quantidade x @produtos[item.ID_Produto].Nome</span>
                    <span>@((item.Preco * item.Quantidade).ToString("C", br))</span>
                </p>
            }
            <hr />
            <p class="finalizar-linha">
                <span>Subtotal</span>
                <span>@subtotal.ToString("C", br)</span>
            </p>
            <p id="linhaTaxa" class="finalizar-linha @(ehEntrega ? "" : "finalizar-oculto")">
                <span>Taxa de entrega</span>
                <span>@taxa.ToString("C", br)</span>
            </p>
            <p class="finalizar-linha finalizar-total">
                <span>Total</span>
                <span id="totalFinal"
                      data-retirada="@subtotal.ToString("C", br)"
                      data-entrega="@((subtotal + taxa).ToString("C", br))">
                    @((ehEntrega ? subtotal + taxa : subtotal).ToString("C", br))
                </span>
            </p>
        </div>

    </div>

</section>

@section Scripts {
    <script>
        const blocoEntrega = document.getElementById('blocoEntrega');
        const linhaTaxa = document.getElementById('linhaTaxa');
        const totalFinal = document.getElementById('totalFinal');
        const opcaoEntrega = document.getElementById('tipoEntrega');

        function atualizarTela() {
            const entrega = opcaoEntrega.checked;
            blocoEntrega.classList.toggle('finalizar-oculto', !entrega);
            linhaTaxa.classList.toggle('finalizar-oculto', !entrega);
            totalFinal.textContent = entrega ? totalFinal.dataset.entrega : totalFinal.dataset.retirada;
        }

        document.querySelectorAll('input[name="tipoPedido"]').forEach(function(r) {
            r.addEventListener('change', atualizarTela);
        });
        atualizarTela();
    </script>
}