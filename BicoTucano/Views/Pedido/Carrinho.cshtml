@model List<BicoTucano.Models.Item_Pedido>
@using BicoTucano.Models
@using System.Globalization

@{
    ViewData["Title"] = "Carrinho";
    var br = new CultureInfo("pt-BR");
    var produtos = ViewBag.Produtos as Dictionary<int, Produto> ?? new Dictionary<int, Produto>();

    decimal subTotal = Model?.Sum(i => i.Preco * i.Quantidade) ?? 0;
    decimal taxaEntrega = 6.00m;
    int totalItens = Model?.Sum(i => i.Quantidade) ?? 0;
}

@* Linha para conectar HTML com CSS *@
<link rel="stylesheet" href="~/css/Carrinho.css" asp-append-version="true" />

<div class="carrinho">
    <p class="caminho"><a asp-controller="Home" asp-action="Index">Início</a> &gt; Meu carrinho</p>
    <h1 class="titulo">Meu carrinho <small>(@totalItens itens)</small></h1>

    @if (TempData["MSG_S"] != null)
    {
        <div class="alert alert-success">@TempData["MSG_S"]</div>
    }
    @if (TempData["MSG_E"] != null)
    {
        <div class="alert alert-warning">@TempData["MSG_E"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="vazio">
            <p>Seu carrinho está vazio.</p>
            <a class="botao-laranja" asp-controller="Home" asp-action="Index">Ver cardápio</a>
        </div>
    }
    else
    {
        <div class="produtos-carrinho">
            <div class="lista-produtos">
                @* O foreach vai percorrer todos os produtos da model *@
                @foreach (Item_Pedido item in Model)
                {
                    @* Busca o produto pelo ID *@
                    if (produtos.TryGetValue(item.ID_Produto, out Produto produto))
                    {
                        <div class="item">
                            @* Mostra a imagem do produto *@
                            <img src="~/img/@produto.NomeImagem" alt="@produto.Nome" />

                            @* Mostra o Nome e Categoria *@
                            <div class="item-meio">
                                <h2>@produto.Nome</h2>
                                <small>@produto.Categoria</small>
                            </div>

                            <div class="item-direita">
                                @* Multiplica o preço pela quantidade e transforma em real *@
                                <p class="item-preco">@((item.Preco * item.Quantidade).ToString("C", br))</p>

                                @* Quando o cliente clicar em Remover, o formulário envia o ID do produto *@
                                <form asp-action="RemoverItem" asp-route-id="@item.ID_Produto" method="post">
                                    <button type="submit" class="remover">Remover</button>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="links">
                <a asp-controller="Home" asp-action="Index">Continuar comprando</a>
            </div>

            <div class="caixa" id="endereco-entrega">
                <h3>Entregar no endereço</h3>
                <a class="botao-endereco" asp-controller="Endereco" asp-action="Index">Adicionar endereço</a>
            </div>

            <div class="opcoes-entrega">
                <h3>Opções de entrega</h3>
                <label class="opcao">
                    <div>
                        <b>Delivery</b><br />
                        <small>Entrega no endereço em 30-45 min</small>
                    </div>
                    @*Botão de seleção único*@
                    <input type="radio" name="tipo" value="entrega" checked onchange="atualizar()" />
                </label>

                <label class="opcao">
                    <div>
                        <b>Retirada no Local</b><br />
                        <small>R. Fradique Coutinho, 088 - Pronto em 20 min</small>
                    </div>
                    @*Botão de seleção único*@
                    <input type="radio" name="tipo" value="retirada" onchange="atualizar()" />
                </label>
            </div>
        </div>

        <div class="resumo">
            <h2>Resumo do Pedido</h2>

            <div class="subtotal">
                <span>Subtotal (@totalItens itens)</span>
                <span>@subTotal.ToString("C", br)</span>
            </div>

            <div class="taxadeentrega">
                <span>Taxa de Entrega</span>
                <span id="taxa">@taxaEntrega.ToString("C", br)</span>
            </div>

            <hr />

            <div class="total">
                <span>Total</span>
                <span id="total">@((subTotal + taxaEntrega).ToString("C", br))</span>
            </div>

            <a class="botao-laranja" asp-action="Finalizar">Finalizar Pedido</a>

            <p class="pagamento">
                Pagamento com: PIX, VISA, MASTER<br />
                Pagamento 100% seguro e criptografado
            </p>
        </div>
    }
</div>