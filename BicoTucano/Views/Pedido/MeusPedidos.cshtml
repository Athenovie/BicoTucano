@model IEnumerable<BicoTucano.Models.Pedido>
@using BicoTucano.Models

@{
    ViewBag.Title = "Meus Pedidos";
    ViewData["LarguraTotal"] = true;

    var pt = new System.Globalization.CultureInfo("pt-BR");
    var produtos = (Dictionary<int, List<Produto>>)ViewBag.Produtos;
    var cliente = (Cliente)ViewBag.Cliente;
}

<link rel="stylesheet" href="~/css/MenuPerfil.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/MeusPedidos.css" asp-append-version="true" />

<section class="perfil-pagina">

    <aside class="perfil-menu">
        <div class="perfil-menu-topo">
            <div class="perfil-foto" aria-hidden="true">@cliente.Nome.Substring(0, 1)</div>
            <strong>@cliente.Nome</strong>
            <small>@cliente.Email</small>
        </div>

        <nav aria-label="Perfil">
            <a asp-controller="Home" asp-action="Perfil" class="perfil-menu-link">Meu Perfil</a>
            <a asp-controller="Pedido" asp-action="MeusPedidos" class="perfil-menu-link perfil-menu-link-ativo">Meus Pedidos</a>
            <a asp-controller="Cartao" asp-action="Index" class="perfil-menu-link">Meus Cartões</a>
            <a asp-controller="Home" asp-action="LogoutCliente" class="perfil-menu-link perfil-menu-link-sair">Sair</a>
        </nav>
    </aside>

    <div class="perfil-principal">

        <h1 class="perfil-titulo">Meus pedidos</h1>

        @if (!Model.Any())
        {
            <div class="pedidos-vazio">
                <img src="~/img/pedidosvazio.png" alt="" class="pedidos-vazio-imagem" />

                <h2 class="pedidos-vazio-titulo">Não há pedidos no momento</h2>

                <p class="pedidos-vazio-texto">
                    Explore nossa variedade de pratos veganos e faça seu primeiro pedido!
                </p>

                <a asp-controller="Produto" asp-action="Index" class="pedidos-vazio-botao">Explorar Cardápio</a>
            </div>
        }
        else
        {
            @foreach (Pedido p in Model)
            {
                string statusTexto = "Em preparo";
                string statusClasse = "pedido-status-preparo";

                if (p.StatusPedido == StatusPedido.EmEntrega)
                {
                    statusTexto = "Em entrega";
                    statusClasse = "pedido-status-entrega";
                }
                else if (p.StatusPedido == StatusPedido.Concluido)
                {
                    statusTexto = "Concluído";
                    statusClasse = "pedido-status-concluido";
                }

                <article class="pedido-card">

                    <div class="pedido-topo">
                        <h2 class="pedido-numero">Nº pedido @p.NF</h2>
                        <span class="pedido-status @statusClasse">@statusTexto</span>
                    </div>

                    <ul class="pedido-itens">
                        @foreach (Produto produto in produtos[p.NF])
                        {
                            <li class="pedido-item">
                                <img src="~/img/@produto.NomeImagem" alt="@produto.Nome" />
                                <span>@produto.Nome</span>
                            </li>
                        }
                    </ul>

                    <div class="pedido-rodape">
                        <strong class="pedido-total">R$ @p.ValorTotal.ToString("N2", pt)</strong>
                        <a asp-action="Confirmacao" asp-route-id="@p.NF" class="pedido-detalhes">Detalhes</a>
                    </div>

                </article>
            }
        }

    </div>

</section>