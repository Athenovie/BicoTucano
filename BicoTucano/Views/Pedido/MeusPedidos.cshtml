@model IEnumerable<BicoTucano.Models.Pedido>
@using BicoTucano.Models

@{
    ViewBag.Title = "Meus Pedidos";
    var pt = new System.Globalization.CultureInfo("pt-BR");
    var produtos = (Dictionary<int, List<Produto>>)ViewBag.Produtos;
}

<div class="container mt-4">
    <div class="row">

        <div class="col-md-3 mb-3">
            <partial name="_MenuConta" />
        </div>

        <div class="col-md-9">
            <h2>MEUS PEDIDOS</h2>

            @if (!Model.Any())
            {
                <div class="text-center my-5">
                    <h3>Não há pedidos no momento</h3>
                    <p class="text-muted">Explore nossa variedade de pratos veganos e faça seu primeiro pedido!</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-lg text-white rounded-pill" style="background:#e8845c;">Explorar Cardápio</a>
                </div>
            }
            else
            {
                @foreach (var p in Model)
                {
                    string statusTexto = "Em preparo";
                    string statusCor = "#e8845c";

                    if (p.StatusPedido == StatusPedido.EmEntrega)
                    {
                        statusTexto = "Em entrega";
                        statusCor = "#f0b429";
                    }
                    else if (p.StatusPedido == StatusPedido.Concluido)
                    {
                        statusTexto = "Concluído";
                        statusCor = "#4a7c59";
                    }

                    <div class="card p-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <strong>Nº pedido @p.NF</strong>
                            <strong style="color:@statusCor;">@statusTexto</strong>
                        </div>

                        <div class="d-flex flex-wrap mt-2">
                            @foreach (var produto in produtos[p.NF])
                            {
                                <div class="text-center mr-3 mb-2" style="width:80px;">
                                    <img src="~/Imagens/@produto.NomeImagem" style="width:70px; height:70px; object-fit:cover; border-radius:12px;" />
                                    <div style="font-size:11px;">@produto.Nome</div>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0" style="color:#2f6b3f;">R$ @p.ValorTotal.ToString("N2", pt)</h4>
                            <a asp-action="Confirmacao" asp-route-id="@p.NF" class="text-muted">Detalhes</a>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>