@{
    var larguraTotal = ViewData["LarguraTotal"] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BicoTucano</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BicoTucano.styles.css" asp-append-version="true" />
    @inject BicoTucano.Libraries.Login.LoginCliente _LoginCliente
    @inject BicoTucano.Libraries.Login.LoginFuncionario _LoginFuncionario
    @inject BicoTucano.CarrinhoCompra.CookieCarrinhoCompra _Carrinho

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Bico de Tucano</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Pedido" asp-action="Carrinho">Carrinho (@_Carrinho.TotalItens())</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Funcionario/Home/Login"><i class="fas fa-user-alt"></i> Login Funcionário</a>
                        </li>

                        <li>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cartao" asp-action="Index">Meus Cartões</a>
                            
                        </li>
                    </ul>
                    <li class="nav-item dropdown" style="list-style:none">
                        @if (_LoginCliente.GetCliente() != null)
                        {
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">@_LoginCliente.GetCliente().Nome</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Minhas Compras</a></li>
                                <li><a class="dropdown-item" href="#">Meus Perfil</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Endereco" asp-action="Index">Meus Endereços</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Home/LogoutCliente">Sair</a></li>
                            </ul>
                        }
                        else
                        {
                            <a class="nav-link" href="/Home/Login"><i class="fas fa-user-alt"></i> Login</a>
                        }
                    </li>
                </div>
            </div>
        </nav>
    </header>
    <div class="@(larguraTotal ? "" : "container")">
        <main role="main" class="@(larguraTotal ? "" : "pb-3")">
            @RenderBody()
        </main>
    </div>

    <footer class="rodape">

        <div class="rodape-conteudo">

            <div class="rodape-marca">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-tucano.png" alt="Bico de Tucano" class="rodape-logo" />
                </a>

                <p class="rodape-descricao">
                    Culinária vegana artesanal feita com amor, ingredientes frescos e cuidado com o planeta.
                </p>

                <div class="rodape-redes">
                    <a href="https://www.instagram.com/athenovie/" class="rodape-rede" aria-label="Instagram" target="_blank" rel="noopener">
                        <img src="~/img/instagram.png" alt="" />
                    </a>
                    <a href="https://wa.me/5511999998888" class="rodape-rede" aria-label="WhatsApp" target="_blank" rel="noopener">
                        <img src="~/img/whatsapp.png" alt="" />
                    </a>
                    <a href="https://www.facebook.com/" class="rodape-rede" aria-label="Facebook" target="_blank" rel="noopener">
                        <img src="~/img/facebook.png" alt="" />
                    </a>
                </div>
            </div>

            
            <nav class="rodape-coluna" aria-label="Cardápio">
                <h3 class="rodape-titulo">Cardápio</h3>
                <ul class="rodape-lista">
                    @* esses links ainda nao funcionam *@
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Entradas">Entradas</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Lanches">Lanches</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Pratos Completos">Pratos Completos</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Sobremesas">Sobremesas</a></li>
                </ul>
            </nav>

            
            <nav class="rodape-coluna" aria-label="Ajuda">
                <h3 class="rodape-titulo">Ajuda</h3>
                <ul class="rodape-lista">
                    @* esses links ainda nao funcionam *@
                    <li><a asp-controller="Cliente" asp-action="Perfil">Meu Perfil</a></li>
                    <li><a asp-controller="Home" asp-action="Contato">Fale conosco</a></li>
                </ul>
            </nav>

            
            <div class="rodape-coluna">
                <h3 class="rodape-titulo">Contato</h3>
                <ul class="rodape-lista">
                    <li>R. Fradique Coutinho, 986 - Pinheiros</li>
                    <li><a>(11) 99999-8888</a></li>
                    <li><a">bicodetucano@gmail.com</a></li>
                </ul>
            </div>

        </div>

        <div class="rodape-base">
            <span>© 2026 Bico de Tucano. Todos os direitos reservados.</span>
            <span>Feito com carinho e ingredientes frescos.</span>
        </div>

    </footer>
                        <script src="https://cdn.jsdelivr.net/npm/sienna-accessibility/dist/sienna-accessibility.umd.js" async></script>
                        <script src="https://vlibras.gov.br/app/vlibras-plugin.js" defer></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/resources/lib/mask/jquery.mask.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
