@{
    var larguraTotal = ViewData["LarguraTotal"] as bool? ?? false;

    var clienteLogado = _LoginCliente.GetCliente();
    string buscaAtual = Context.Request.Query["busca"].ToString();
    int itensCarrinho = _Carrinho.TotalItens();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BicoTucano</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Cabecalho.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BicoTucano.styles.css" asp-append-version="true" />
    @inject BicoTucano.Libraries.Login.LoginCliente _LoginCliente
    @inject BicoTucano.Libraries.Login.LoginFuncionario _LoginFuncionario
    @inject BicoTucano.CarrinhoCompra.CookieCarrinhoCompra _Carrinho

</head>
<body class="@(larguraTotal ? "fundo-bege" : "")">
    <header class="cabecalho">
        <div class="cabecalho-conteudo">

            <a class="cabecalho-logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Bico de Tucano, página inicial">
                <img src="~/img/logo-tucano-verde.png" alt="Bico de Tucano" />
            </a>

            <form class="cabecalho-busca" method="get" asp-area="" asp-controller="Produto" asp-action="Index" role="search">
                <img src="~/img/busca.png" aria-hidden="true" />
                <input type="search" name="busca" value="@buscaAtual" placeholder="Buscar pratos" aria-label="Buscar pratos" autocomplete="off" />
            </form>

            <nav class="cabecalho-links" aria-label="Principal">
                <a asp-area="" asp-controller="Produto" asp-action="Index">Cardápio</a>
            </nav>

            <div class="cabecalho-acoes">
                <a class="cabecalho-carrinho" asp-area="" asp-controller="Pedido" asp-action="Carrinho" aria-label="Carrinho, @itensCarrinho itens">
                    <img src="~/img/carrinho.png" />

                    @if (itensCarrinho > 0)
                    {
                        <span class="cabecalho-carrinho-contador">@itensCarrinho</span>
                    }
                </a>

                @if (clienteLogado != null)
                {
                    <a class="cabecalho-perfil" asp-area="" asp-controller="Home" asp-action="Perfil"
                       aria-label="Meu perfil" title="@clienteLogado.Nome">@clienteLogado.Nome.Substring(0, 1)</a>
                }
                else
                {
                    <a class="cabecalho-entrar" asp-area="" asp-controller="Home" asp-action="Login">Entrar</a>
                }
            </div>

        </div>
    </header>
    <div class="conteudo-pagina @(larguraTotal ? "" : "container")">
        <main role="main" class="@(larguraTotal ? "" : "pb-3")">
            @RenderBody()
        </main>
    </div>

    <footer class="rodape">

        <div class="rodape-conteudo">

            <div class="rodape-marca">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-tucano.png" alt="Bico de Tucano" class="rodape-logo" />
                </a>

                <p class="rodape-descricao">
                    Culinária vegana artesanal feita com amor, ingredientes frescos e cuidado com o planeta.
                </p>

                <div class="rodape-redes">
                    <a href="https://www.instagram.com/athenovie/" class="rodape-rede" aria-label="Instagram" target="_blank" rel="noopener">
                        <img src="~/img/instagram.png" alt="" />
                    </a>
                    <a href="https://wa.me/5511999998888" class="rodape-rede" aria-label="WhatsApp" target="_blank" rel="noopener">
                        <img src="~/img/whatsapp.png" alt="" />
                    </a>
                    <a href="https://www.facebook.com/" class="rodape-rede" aria-label="Facebook" target="_blank" rel="noopener">
                        <img src="~/img/facebook.png" alt="" />
                    </a>
                </div>
            </div>

            
            <nav class="rodape-coluna" aria-label="Cardápio">
                <h3 class="rodape-titulo">Cardápio</h3>
                <ul class="rodape-lista">
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Entrada">Entradas</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Prato Completo">Pratos Completos</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Lanche">Lanches</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Sobremesa">Sobremesas</a></li>
                    <li><a asp-controller="Produto" asp-action="Index" asp-route-categoria="Bebida">Bebidas</a></li>
                </ul>
            </nav>

            
            <nav class="rodape-coluna" aria-label="Ajuda">
                <h3 class="rodape-titulo">Ajuda</h3>
                <ul class="rodape-lista">
                    @* esses links ainda nao funcionam *@
                    <li><a asp-controller="Home" asp-action="Perfil">Meu Perfil</a></li>
                    <li><a asp-controller="Home" asp-action="Contato">Fale conosco</a></li>
                </ul>
            </nav>

            
            <div class="rodape-coluna">
                <h3 class="rodape-titulo">Contato</h3>
                <ul class="rodape-lista">
                    <li>R. Fradique Coutinho, 986 - Pinheiros</li>
                    <li><a>(11) 99999-8888</a></li>
                    <li><a">bicodetucano@gmail.com</a></li>
                </ul>
            </div>

        </div>

        <div class="rodape-base">
            <span>© 2026 Bico de Tucano. Todos os direitos reservados.</span>
            <span>Feito com carinho e ingredientes frescos.</span>
        </div>

    </footer>
                        <script src="https://cdn.jsdelivr.net/npm/sienna-accessibility/dist/sienna-accessibility.umd.js" async></script>
                        <script src="https://vlibras.gov.br/app/vlibras-plugin.js" defer></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/resources/lib/mask/jquery.mask.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
