@model BicoTucano.Models.Produto

@{
    ViewBag.Title = "Cadastrar Produto";
}

<link rel="stylesheet" href="~/css/CadastroProduto.css" />

<div class="pagina-cadastro-produto">

    <div class="cabecalho-cadastro-produto">
        <h2>CADASTRAR PRODUTO</h2>
        <span class="identificacao-administrador">👨 Administrador</span>
    </div>

    <form asp-action="Cadastrar" asp-controller="Produto"
          method="post" enctype="multipart/form-data">
          @*Não mexi já veio do Bootstrap*@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="formulario-cadastro-produto">

            <div class="informacoes-produto">

                <div class="campo-informacao-produto">
                    <label asp-for="Nome">Nome <span>*</span></label>
                    <input asp-for="Nome" placeholder="Digite o nome do produto" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="campos-preco-categoria">

                    <div class="campo-informacao-produto">
                        <label asp-for="Preco">Valor Unitário <span>*</span></label>
                        <input asp-for="Preco" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>

                    <div class="campo-informacao-produto">
                        <label asp-for="ID_Categoria">Categoria <span>*</span></label>
                        <select asp-for="ID_Categoria"
                                asp-items="(SelectList)ViewBag.Categorias">
                            <option value="">Selecione</option>
                        </select>
                        <span asp-validation-for="ID_Categoria" class="text-danger"></span>
                    </div>

                </div>

                <div class="campo-informacao-produto">
                    <label asp-for="Descricao">Descrição <span>*</span></label>
                    <textarea asp-for="Descricao" rows="4"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="disponibilidade-produto">
                    <p>Disponibilidade <span>*</span></p>

                    <label>
                        <input asp-for="Disponibilidade"
                               type="radio" value="true" />
                        Disponível
                    </label>

                    <label>
                        <input asp-for="Disponibilidade"
                               type="radio" value="false" />
                        Indisponível
                    </label>
                </div>

            </div>

            <div class="area-imagem-botoes">

                <div class="area-upload-imagem">
                    <label for="file">Imagem <span>*</span></label>

                    <label for="file" class="botao-adicionar-imagem">
                        <span>+</span>
                    </label>

                    <input type="file" name="file" id="file"
                           accept="image/*" />

                    <span asp-validation-for="NomeImagem"
                          class="text-danger"></span>
                </div>

                <div class="acoes-cadastro-produto">
                    <a asp-action="Index" class="botao-cancelar-cadastro">
                        Cancelar
                    </a>

                    <button type="submit" class="botao-salvar-produto">
                        Salvar
                    </button>
                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
