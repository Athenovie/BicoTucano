@model IEnumerable<BicoTucano.Models.Produto>

@{
    ViewBag.Title = "Produtos";
    ViewData["SemBusca"] = true;
    var pt = new System.Globalization.CultureInfo("pt-BR");
}

<header class="produtos-cabecalho">
    <h2>PRODUTOS</h2>
    <a asp-action="Cadastrar" class="botao-cadastrar">CADASTRAR PRODUTO</a>
</header>

<section class="produtos-lista">
    @foreach (var produto in Model)
    {
        <article class="produto-cartao">
            @if (!string.IsNullOrEmpty(produto.NomeImagem))
            {
                <img class="produto-cartao-imagem" src="~/img/@produto.NomeImagem" alt="@produto.Nome" />
            }

            <div class="produto-cartao-texto">
                <h3 class="produto-cartao-nome">@produto.Nome</h3>
                <p class="produto-cartao-descricao">@produto.Descricao</p>
                <small class="produto-cartao-legenda">a partir de</small>
                <strong class="produto-cartao-preco">R$ @produto.Preco.ToString("N2", pt)</strong>
            </div>

            <div class="produto-cartao-botoes">
                <form asp-action="AlterarDisponibilidade" method="post">
                    <input type="hidden" name="id" value="@produto.ID_Produto" />
                    <input type="hidden" name="disponibilidade" value="@((!produto.Disponibilidade).ToString().ToLower())" />
                    <button type="submit" class="botao-acao">@(produto.Disponibilidade ? "DESATIVAR" : "ATIVAR")</button>
                </form>

                <a asp-action="Alterar" asp-route-id="@produto.ID_Produto" class="botao-acao">ALTERAR</a>
            </div>
        </article>
    }
</section>