@model IEnumerable<BicoTucano.Models.Produto>

@{
    ViewBag.Title = "Produtos";
    var pt = new System.Globalization.CultureInfo("pt-BR");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>PRODUTOS</h1>
    <a asp-action="Cadastrar" class="btn btn-success rounded-pill">CADASTRAR PRODUTO</a>
</div>

<div class="row">
    @foreach (var produto in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">

                @if (!string.IsNullOrEmpty(produto.NomeImagem))
                {
                    <img src="~/img/@produto.NomeImagem" class="card-img-top" style="height:180px; object-fit:cover;" />
                }

                <div class="card-body">
                    <h5 class="card-title">@produto.Nome</h5>
                    <p class="card-text">@produto.Descricao</p>
                    <small>a partir de</small><br />
                    <strong>R$ @produto.Preco.ToString("N2", pt)</strong>

                    @if (!produto.Disponibilidade)
                    {
                        <span class="badge badge-secondary ml-2">Indisponível</span>
                    }
                </div>

                <div class="card-footer bg-white border-0 d-flex justify-content-center">

                    <form asp-action="AlterarDisponibilidade" method="post" class="mr-2">
                        <input type="hidden" name="id" value="@produto.ID_Produto" />
                        <input type="hidden" name="disponibilidade" value="@((!produto.Disponibilidade).ToString().ToLower())" />
                        <button type="submit" class="btn btn-sm btn-warning rounded-pill">
                            @(produto.Disponibilidade ? "DESATIVAR" : "ATIVAR")
                        </button>
                    </form>

                    <a asp-action="Alterar" asp-route-id="@produto.ID_Produto" class="btn btn-sm btn-warning rounded-pill">ALTERAR</a>
                </div>

            </div>
        </div>
    }
</div>