@model BicoTucano.Models.Produto

@{
    ViewBag.Title = "Alterar Produto";
}

<link rel="stylesheet" href="~/css/AlterarProduto.css" />

<div class="pagina-alterar-produto">
    <div class="cabecalho-alterar-produto">
        <h2>ALTERAR PRODUTO</h2>
    </div>

    <form asp-action="Alterar" asp-controller="Produto" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="erros-alterar-produto"></div>

        <input type="hidden" asp-for="ID_Produto" />
        <input type="hidden" asp-for="NomeImagem" />

        <div class="formulario-alterar-produto">
            <section class="informacoes-alterar-produto">
                <div class="campo-alterar-produto">
                    <label asp-for="Nome">Nome *</label>
                    <input asp-for="Nome" placeholder="Digite o nome do produto" />
                    <span asp-validation-for="Nome" class="erro-campo-alterar-produto"></span>
                </div>

                <div class="campos-preco-categoria-alterar">
                    <div class="campo-alterar-produto">
                        <label asp-for="Preco">Valor Unitário *</label>
                        <input asp-for="Preco" type="number" step="0.01" />
                        <span asp-validation-for="Preco" class="erro-campo-alterar-produto"></span>
                    </div>

                    <div class="campo-alterar-produto">
                        <label asp-for="ID_Categoria">Categoria *</label>
                        <select asp-for="ID_Categoria" asp-items="(SelectList)ViewBag.Categorias"></select>
                        <span asp-validation-for="ID_Categoria" class="erro-campo-alterar-produto"></span>
                    </div>
                </div>

                <div class="campo-alterar-produto">
                    <label asp-for="Descricao">Descrição *</label>
                    <textarea asp-for="Descricao" rows="4"></textarea>
                    <span asp-validation-for="Descricao" class="erro-campo-alterar-produto"></span>
                </div>

                <div class="disponibilidade-alterar-produto">
                    <p>Disponibilidade *</p>
                    <label>
                        <input type="radio" asp-for="Disponibilidade" value="true" />
                        Disponível
                    </label>
                    <label>
                        <input type="radio" asp-for="Disponibilidade" value="false" />
                        Indisponível
                    </label>
                </div>
            </section>

            <aside class="area-imagem-alterar-produto">
                <div class="cartao-imagem-alterar-produto">
                    <label for="file">Imagem *</label>

                    @if (!string.IsNullOrEmpty(Model.NomeImagem))
                    {
                        <img id="previa" src="~/img/@Model.NomeImagem" class="previa-imagem-produto" />
                    }
                    else
                    {
                        <img id="previa" class="previa-imagem-produto previa-imagem-oculta" />
                    }

                    <input type="file" name="file" id="file" accept="image/*" />
                    <small>Deixe em branco para manter a imagem atual.</small>
                </div>

                <div class="acoes-alterar-produto">
                    <a asp-action="Index" class="botao-cancelar-alterar-produto">Cancelar</a>
                    <button type="submit" class="botao-salvar-alterar-produto">Salvar</button>
                </div>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("file").addEventListener("change", function() {
            var arquivo = this.files[0];
            if (arquivo) {
                var previa = document.getElementById("previa");
                previa.src = URL.createObjectURL(arquivo);
                previa.style.display = "block";
            }
        });
    </script>
}
