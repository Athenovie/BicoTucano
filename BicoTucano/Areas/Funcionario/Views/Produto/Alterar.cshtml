@model BicoTucano.Models.Produto

@{
    ViewBag.Title = "Alterar Produto";
}

<h1>ALTERAR PRODUTO</h1>

<form asp-action="Alterar" asp-controller="Produto" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="ID_Produto" />
    <input type="hidden" asp-for="NomeImagem" />

    <div class="row">

        <div class="col-md-8">
            <div class="card p-3 mb-3">

                <div class="form-group">
                    <label asp-for="Nome">Nome *</label>
                    <input asp-for="Nome" class="form-control" placeholder="Digite o nome do produto" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Preco">Valor Unitário *</label>
                        <input asp-for="Preco" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="ID_Categoria">Categoria *</label>
                        <select asp-for="ID_Categoria" asp-items="(SelectList)ViewBag.Categorias" class="form-control"></select>
                        <span asp-validation-for="ID_Categoria" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Descricao">Descrição *</label>
                    <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Disponibilidade *</label><br />
                    <label class="mr-3">
                        <input type="radio" asp-for="Disponibilidade" value="true" /> Disponível
                    </label>
                    <label>
                        <input type="radio" asp-for="Disponibilidade" value="false" /> Indisponível
                    </label>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 mb-3">
                <label>Imagem *</label>

                @if (!string.IsNullOrEmpty(Model.NomeImagem))
                {
                    <img id="previa" src="~/img/@Model.NomeImagem" style="width:100%; max-height:200px; object-fit:cover;" class="mb-2" />
                }
                else
                {
                    <img id="previa" style="display:none; width:100%; max-height:200px; object-fit:cover;" class="mb-2" />
                }

                <input type="file" name="file" id="file" accept="image/*" />
                <small class="text-muted">Deixe em branco para manter a imagem atual.</small>
            </div>

            <a asp-action="Index" class="btn btn-light rounded-pill">Cancelar</a>
            <button type="submit" class="btn btn-warning rounded-pill">Salvar</button>
        </div>

    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById("file").addEventListener("change", function() {
            var arquivo = this.files[0];
            if (arquivo) {
                var previa = document.getElementById("previa");
                previa.src = URL.createObjectURL(arquivo);
                previa.style.display = "block";
            }
        });
    </script>
}