@model IEnumerable<BicoTucano.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}


<h2>CLIENTES</h2>
<!--Código embutido do Bootstrap-->
            @if (TempData["MSG_E"] !=null)
            {
    <div class="alert alert-danger">@TempData["MSG_E"]</div>
}
<a asp-action="Cadastrar" class="botao-cadastrar">CADASTRAR CLIENTE</a>

<div class="tabela">
    <table id="tabelaClientes" data-pesquisavel>
        <thead>
            <tr>
                <th>CÓDIGO</th>
                <th>NOME</th>
                <th>CPF</th>
                <th>TELEFONE</th>
                <th>EMAIL</th>
                <th>AÇÕES</th>
            </tr>
        </thead>
        <tbody>
            <!--foreach cria uma linha para cada cliente da lista, e cada td(célula) mostra um dado-->
            @foreach (Cliente cliente in Model)
            {
                <tr>
                    <td>@cliente.ID_Usuario</td>
                    <td>@cliente.Nome</td>
                    <td>@cliente.CPF</td>
                    <td>@cliente.Telefone</td>
                    <td>@cliente.Email</td>
                    <td data-sem-busca>
                        @if (cliente.Situacao == "A")
                        {
                            <form asp-action="Desativar" asp-route-id="@cliente.ID_Usuario" method="post"
                                  onsubmit="return confirm('Deseja realmente desligar?');">
                                <button type="submit" class="botao-acao">Desligar</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Ativar" asp-route-id="@cliente.ID_Usuario" method="post"
                                  onsubmit="return confirm('Deseja realmente reativar?');">
                                <button type="submit" class="botao-acao">Reativar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!--Essa parte não mexi-->
@section Scripts {
    <script src="~/js/PesquisaTabela.js" asp-append-version="true"></script>
}