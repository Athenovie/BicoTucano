@model IEnumerable<BicoTucano.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}


            <h1>Clientes</h1>

            @if (TempData["MSG_E"] !=null)
            {
    <div class="alert alert-danger">@TempData["MSG_E"]</div>
}
<p class="btn btn-outline-primary" role="button">
                <a asp-action="Cadastrar">
                    <span class="fas fa-user-plus" title="Cadastro" aria-hidden="true"></span>
                    <span>Cadastrar</span>
                </a>
            </p>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">@Html.DisplayNameFor(model => model.First().ID_Usuario)</th>
                            <th scope="col">@Html.DisplayNameFor(model => model.First().Nome)</th>
                            <th scope="col">@Html.DisplayNameFor(model => model.First().CPF)</th>
                            <th scope="col">@Html.DisplayNameFor(model => model.First().Telefone)</th>
                            <th scope="col">@Html.DisplayNameFor(model => model.First().Email)</th>
                            <th scope="col">Ações</th>
                        </tr>
                    </thead>
            <tbody>
                @foreach (Cliente cliente in Model)
                {
                    <tr>
                        <th scope="row">@cliente.ID_Usuario</th>
                        <td>@cliente.Nome</td>
                        <td>@cliente.CPF</td>
                        <td>@cliente.Telefone</td>
                        <td>@cliente.Email</td>
                       

                        <td>
                            <a class="btn btn-primary btn-sm" asp-action="Atualizar" asp-route-id="@cliente.ID_Usuario">Editar</a>

                             @if (cliente.Situacao == "A")
                                {
                                    <form asp-action="Desativar" asp-route-id="@cliente.ID_Usuario" method="post" class="d-inline"
                                          onsubmit="return confirm('Deseja realmente desativar?');">
                                        <button type="submit" class="btn btn-warning btn-sm">Desativar</button>
                                    </form>
                                }
                                    else if (cliente.Situacao == "D")
                                    {
                                        <form asp-action="Ativar" asp-route-id="@cliente.ID_Usuario" method="post" class="d-inline"
                                              onsubmit="return confirm('Deseja realmente ativar?');">
                                            <button type="submit" class="btn btn-secondary btn-sm">Ativar</button>
                                        </form>
                                    }
                                        <form asp-action="Excluir" asp-route-id="@cliente.ID_Usuario" method="post" class="d-inline"
                                              onsubmit="return confirm('Excluir definitivamente este cliente?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                        </form>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>