@model BicoTucano.Models.Cliente
@{
    ViewData["Title"] = "Atualizar cliente";
}

<h1>Atualizar cliente</h1>

@if (ViewData["MSG_E"] != null)
{
    <div class="alert alert-danger">@ViewData["MSG_E"]</div>
}

<form asp-action="Atualizar"  method="post" class="col-md-6 p-0">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="ID_Usuario" />

    <div class="form-group">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CPF"></label>
        <input asp-for="CPF" class="form-control" />
        <span asp-validation-for="CPF" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Telefone"></label>
        <input asp-for="Telefone" value="@(Model?.Telefone.HasValue == true ? Model.Telefone.Value.ToString("F0") : "")" class="form-control" type="text" inputmode="numeric" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DataNasc"></label>
        <input asp-for="DataNasc" type="date" class="form-control" />
        <span asp-validation-for="DataNasc" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Sexo"></label>
        <select asp-for="Sexo" class="form-control">
            <option value="M">Masculino</option>
            <option value="F">Feminino</option>
        </select>
        <span asp-validation-for="Sexo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Salvar</button>
    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
</form>