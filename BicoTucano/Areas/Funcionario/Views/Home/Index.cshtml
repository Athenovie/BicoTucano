@model IEnumerable<BicoTucano.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}
<!--Página para listar os funcionários do restaurante-->
  <h2>FUNCIONÁRIOS</h2>
  <a asp-action="Cadastrar" class="botao-cadastrar">
    CADASTRAR FUNCIONÁRIO
</a>

<div class="tabela">

    <table>
        <thead>
            <tr>
                <th>CÓDIGO</th>
                <th>NOME</th>
                <th>CPF</th>
                <th>TELEFONE</th>
                <th>EMAIL</th>
                <th>CARGO</th>
                <th>NÍVEL DE ACESSO</th>
                <th>AÇÕES</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Funcionario funcionario in Model)
            {
                <tr>
                    <td>@funcionario.ID_Usuario</td>
                    <td>@funcionario.Nome</td>
                    <td>@funcionario.CPF</td>
                    <td>@funcionario.Telefone</td>
                    <td>@funcionario.Email</td>
                    <td>@funcionario.Cargo</td>
                    <td>@funcionario.NivelAcesso</td>

                    <td>
                        @if (funcionario.DataDemissao == default(DateTime))
                        {
                            <a asp-action="Desligar"
                               asp-route-id="@funcionario.ID_Usuario"
                               class="botao-acao"
                               onclick="return confirm('Deseja realmente desligar?');">
                                Desligar
                            </a>
                        }
                        else
                        {
                            <a asp-action="Reativar"
                               asp-route-id="@funcionario.ID_Usuario"
                               class="botao-acao"
                               onclick="return confirm('Deseja realmente reativar?');">
                                Reativar
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
            