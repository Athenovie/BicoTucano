@model IEnumerable<BicoTucano.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
    ViewData["PlaceholderBusca"] = "⌕  Buscar por nome, e-mail, CPF ou cargo...";
}

<section class="funcionarios-pagina">
    <h2>FUNCIONÁRIOS</h2>

    <a asp-action="Cadastrar" class="botao-cadastrar">
        CADASTRAR FUNCIONÁRIO
    </a>

    <div class="tabela">
        <table id="tabelaFuncionarios" data-pesquisavel>
            <thead>
                <tr>
                    <th>CÓDIGO</th>
                    <th>NOME</th>
                    <th>CPF</th>
                    <th>TELEFONE</th>
                    <th>EMAIL</th>
                    <th>CARGO</th>
                    <th>NÍVEL DE ACESSO</th>
                    <th>AÇÕES</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Funcionario funcionario in Model)
                {
                    <tr>
                        <td>@funcionario.ID_Usuario</td>
                        <td>@funcionario.Nome</td>
                        <td>@funcionario.CPF</td>
                        <td>@funcionario.Telefone</td>
                        <td>@funcionario.Email</td>
                        <td>@funcionario.Cargo</td>
                        <td>@funcionario.NivelAcesso</td>
                        <td data-sem-busca>
                            <div class="acoes-funcionario">
                                <a asp-action="Detalhes" asp-route-id="@funcionario.ID_Usuario" class="funcionario-detalhes">Detalhes</a>

                                @if (funcionario.DataDemissao.Year > 1)
                                {
                                    <form asp-action="Ativar" method="post">
                                        <input type="hidden" name="id" value="@funcionario.ID_Usuario" />
                                        <button type="submit" class="funcionario-ativar">Ativar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Desativar" method="post">
                                        <input type="hidden" name="id" value="@funcionario.ID_Usuario" />
                                        <button type="submit" class="funcionario-desativar">Desativar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p id="pesquisa-vazia" class="pesquisa-vazia">Nenhum funcionário encontrado.</p>
    </div>
</section>

@section Scripts {
    <script src="~/js/PesquisaTabela.js" asp-append-version="true"></script>
}