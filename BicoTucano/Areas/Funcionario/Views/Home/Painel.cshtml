@model BicoTucano.Models.Dashboard
@using BicoTucano.Models

@{
    ViewBag.Title = "Dashboard";
    var pt = new System.Globalization.CultureInfo("pt-BR");
    bool ehAdmin = (bool)ViewBag.EhAdmin;

    decimal maior = Model.VendasSemana.Max(v => v.Total);
    if (maior == 0) { maior = 1; }
}

<link rel="stylesheet" href="~/css/Dashboard.css" />

<div class="dashboard-funcionario">
    <p class="dashboard-legenda">VISÃO GERAL</p>
    <h1 class="dashboard-titulo">Acompanhe a movimentação do e-commerce</h1>

    <section class="dashboard-indicadores">
        <article class="dashboard-indicador">
            <span>PEDIDOS EM ANDAMENTO</span>
            <strong>@Model.PedidosEmAndamento</strong>
        </article>
        <article class="dashboard-indicador">
            <span>PEDIDOS HOJE</span>
            <strong>@Model.PedidosHoje</strong>
        </article>

        @if (ehAdmin)
        {
            <article class="dashboard-indicador">
                <span>FATURAMENTO DO MÊS</span>
                <strong>R$ @Model.FaturamentoMes.ToString("N2", pt)</strong>
            </article>
            <article class="dashboard-indicador">
                <span>CLIENTES CADASTRADOS</span>
                <strong>@Model.TotalClientes</strong>
            </article>
        }
    </section>

    <section class="dashboard-destaques">
        @if (ehAdmin)
        {
            <article class="dashboard-cartao dashboard-grafico">
                <h2>Total de vendas (últimos 7 dias)</h2>
                <strong class="dashboard-total-semana">R$ @Model.TotalSemana.ToString("N2", pt)</strong>

                <div class="dashboard-grafico-colunas">
                    @foreach (var v in Model.VendasSemana)
                    {
                        int altura = (int)(v.Total / maior * 100);
                        if (altura < 3) { altura = 3; }

                        <div class="dashboard-grafico-coluna">
                            <div class="dashboard-grafico-barra"
                                 title="R$ @v.Total.ToString("N2", pt)"
                                 style="height:@(altura)%"></div>
                        </div>
                    }
                </div>
                <div class="dashboard-grafico-dias">
                    @foreach (var v in Model.VendasSemana)
                    {
                        <span>@v.Data.ToString("ddd", pt)</span>
                    }
                </div>
            </article>
        }

        <article class="dashboard-cartao dashboard-mais-vendidos">
            <h2>Pratos mais vendidos</h2>

            @if (!Model.MaisVendidos.Any())
            {
                <p class="dashboard-vazio">Ainda não há vendas.</p>
            }

            @{
                int pos = 1;
            }
            @foreach (var prato in Model.MaisVendidos)
            {
                <div class="dashboard-prato">
                    <strong class="dashboard-posicao">@pos</strong>
                    @if (!string.IsNullOrEmpty(prato.NomeImagem))
                    {
                        <img src="~/img/@prato.NomeImagem" alt="@prato.Nome" />
                    }
                    <div class="dashboard-prato-info">
                        <strong>@prato.Nome</strong>
                        <span>@(prato.Quantidade) vendidos</span>
                    </div>
                    @if (ehAdmin)
                    {
                        <strong class="dashboard-prato-total">R$ @prato.Total.ToString("N2", pt)</strong>
                    }
                </div>
                pos++;
            }
        </article>
    </section>

    <section class="dashboard-cartao dashboard-pedidos">
        <h2>Pedidos em andamento</h2>

        @if (!Model.UltimosPedidos.Any())
        {
            <p class="dashboard-vazio">Nenhum pedido em andamento.</p>
        }
        else
        {
            <div class="dashboard-tabela-wrapper">
                <table class="dashboard-tabela">
                    <thead>
                        <tr>
                            <th>Nº</th>
                            <th>CLIENTE</th>
                            <th>STATUS</th>
                            <th>VALOR</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.UltimosPedidos)
                        {
                            <tr>
                                <td>@p.NF</td>
                                <td>@p.Cliente</td>
                                <td>
                                    @if (p.StatusPedido == StatusPedido.EmPreparo)
                                    {
                                        <span class="dashboard-status dashboard-status-preparo">Em preparo</span>
                                    }
                                    else
                                    {
                                        <span class="dashboard-status dashboard-status-entrega">Em entrega</span>
                                    }
                                </td>
                                <td>R$ @p.ValorTotal.ToString("N2", pt)</td>
                                <td>
                                    <a class="dashboard-link-detalhes"
                                       asp-controller="Pedido" asp-action="Detalhes" asp-route-id="@p.NF">DETALHES</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
