@model BicoTucano.Models.Funcionario

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de funcionário</title>
    <link rel="stylesheet" href="~/css/CadastroFuncionario.css" asp-append-version="true">
    <script src="~/js/site.js" defer></script>
</head>

<body>

    <h2>Cadastro de funcionário</h2>

    <form asp-area="Funcionario" asp-controller="Home" asp-action="Cadastrar" method="post" onsubmit="return validarSenhas()">

        <div class="dados-funcionario">

            <div class="campo-formulario campo-inteiro">
                <label asp-for="Nome">Nome Completo</label>
                <input asp-for="Nome" placeholder="Digite seu nome completo">
                <span asp-validation-for="Nome"></span>
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" type="email" placeholder="seu@email.com">
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Telefone">Telefone</label>
                    <input asp-for="Telefone" placeholder="11999999999">
                    <span asp-validation-for="Telefone"></span>
                </div>
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label asp-for="CPF">CPF</label>
                    <input asp-for="CPF" placeholder="000.000.000-00">
                    <span asp-validation-for="CPF"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Sexo">Sexo</label>
                    <select asp-for="Sexo">
                        <option value="">Selecione</option>
                        <option value="M">Masculino</option>
                        <option value="F">Feminino</option>
                    </select>
                    <span asp-validation-for="Sexo"></span>
                </div>
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label asp-for="DataNasc">Data de Nascimento</label>
                    <input asp-for="DataNasc" type="date">
                    <span asp-validation-for="DataNasc"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Cargo">Cargo</label>
                    <input asp-for="Cargo" placeholder="Digite o cargo">
                    <span asp-validation-for="Cargo"></span>
                </div>
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label asp-for="NivelAcesso">Nível de acesso</label>
                    <select asp-for="NivelAcesso">
                        <option value="0">Selecione</option>
                        <option value="1">Comum</option>
                        <option value="2">Administrador</option>
                    </select>
                    <span asp-validation-for="NivelAcesso"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="DataAdmissao">Data de admissão</label>
                    <input asp-for="DataAdmissao" type="date">
                    <span asp-validation-for="DataAdmissao"></span>
                </div>
            </div>

            <div class="campo-formulario">
                <label asp-for="DataDemissao">Data de demissão</label>
                <input asp-for="DataDemissao" type="date">
            </div>

        </div>

        <div class="endereco-funcionario">

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label for="cep">CEP</label>
                    <input id="cep" name="CEP" placeholder="00000-000">
                </div>

                <div class="campo-formulario">
                    <label for="bairro">Bairro</label>
                    <input id="bairro" name="Bairro" placeholder="Digite o bairro">
                </div>
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label for="cidade">Cidade</label>
                    <input id="cidade" name="Cidade" placeholder="Digite a cidade">
                </div>

                <div class="campo-formulario">
                    <label for="estado">Estado</label>
                    <select id="estado" name="Estado">
                        <option value="">Selecione</option>
                        <option value="SP">São Paulo</option>
                        <option value="RJ">Rio de Janeiro</option>
                        <option value="MG">Minas Gerais</option>
                    </select>
                </div>
            </div>

            <div class="campo-formulario campo-inteiro">
                <label for="logradouro">Logradouro</label>
                <input id="logradouro" name="Logradouro" placeholder="Digite o logradouro">
            </div>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label for="complemento">Complemento</label>
                    <input id="complemento" name="Complemento" placeholder="Digite o complemento">
                </div>

                <div class="campo-formulario">
                    <label for="numero">Número</label>
                    <input id="numero" name="Numero" placeholder="Nº">
                </div>
            </div>

        </div>

        <div class="senha-funcionario">

            <h4>Senha para login</h4>
            <p>A senha deve ter entre 6 a 10 caracteres.</p>

            <div class="linha-campos">
                <div class="campo-formulario">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" type="password" id="senha" placeholder="Crie uma senha segura">
                    <span asp-validation-for="Senha"></span>
                </div>

                <div class="campo-formulario">
                    <label for="confirmarSenha">Confirmar senha</label>
                    <input type="password" name="ConfirmarSenha" id="confirmarSenha" placeholder="Repita a senha">
                </div>
            </div>

        </div>

        <div class="botoes-cadastro">
            <button type="reset">Alterar</button>
            <button type="submit">Cadastrar</button>
        </div>

        @if (ViewData["MSG_E"] != null)
        {
            <p class="mensagem-cadastro">@ViewData["MSG_E"]</p>
        }

        @if (ViewData["MSG_S"] != null)
        {
            <p class="mensagem-cadastro">@ViewData["MSG_S"]</p>
        }

    </form>

</body>
</html>
