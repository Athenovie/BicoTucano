@model BicoTucano.Models.Funcionario
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastro | BicoTucano</title>
   
    <script src="~/js/site.js" defer></script>
</head>
<body class="auth-body">

    <div class="auth-wrapper">
        <div class="auth-panel">
            <div class="auth-panel-inner">
                <h1>Cadastre-se</h1>
                <p>
                    Crie sua conta e aproveite os melhores produtos do Bico Tucano
                </p>
            </div>
        </div>

        <div class="auth-form-side">

            <form class="auth-form" asp-action="Cadastrar" method="post" onsubmit="return validarSenhas()">
                <div class="form-field">
                    <label asp-for="Nome">Nome completo</label>
                    <input asp-for="Nome" type="text" id="nome" placeholder="Digite aqui seu nome completo" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" id="email" placeholder="Digite aqui seu email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" type="password" id="senha" placeholder="Digite aqui sua senha" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label for="confirmarSenha">Confirme sua senha</label>
                    <input type="password" id="confirmarSenha" placeholder="Confirme sua senha" />
                </div>

                <div class="form-field">
                    <label asp-for="CPF">CPF</label>
                    <input asp-for="CPF" type="text" placeholder="Digite aqui seu CPF" />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Telefone">Telefone</label>
                    <input asp-for="Telefone" type="text" placeholder="Digite aqui seu telefone" />
                    <span asp-validation-for="Telefone" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="DataNasc">Data de Nascimento</label>
                    <input asp-for="DataNasc" type="date" />
                    <span asp-validation-for="DataNasc" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Sexo">Sexo</label>
                    <select asp-for="Sexo">
                        <option value="">Selecione</option>
                        <option value="M">Masculino</option>
                        <option value="F">Feminino</option>
                    </select>
                    <span asp-validation-for="Sexo" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Cargo">Cargo</label>
                    <input asp-for="Cargo" type="text" placeholder="Digite aqui o cargo" />
                    <span asp-validation-for="Cargo" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="NivelAcesso">Nível de Acesso</label>
                    <select asp-for="NivelAcesso">
                        <option value="">Selecione</option>
                        <option value="Comum">Comum</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <span asp-validation-for="NivelAcesso" class="text-danger"></span>
                </div>

                <div class="auth-form-footer">
                    <span class="auth-switch">Já possui uma conta? <a asp-action="Login">Faça login</a></span>
                    <button type="submit" class="auth-submit">Cadastre-se</button>
                </div>

                
               

                @if (ViewData["MSG_E"] != null)
                {
                    <p class="alert alert-danger">@Html.Raw(ViewData["MSG_E"])</p>
                }
                @if (ViewData["MSG_S"] != null)
                {
                    <p class="alert alert-success">@Html.Raw(ViewData["MSG_S"])</p>
                }
            </form>
        </div>
    </div>

</body>
</html>