@model BicoTucano.Models.Funcionario

@{
    ViewBag.Title = "Modificar Perfil";
}

<h1>MODIFICAR PERFIL</h1>

@if (ViewData["MSG_E"] != null)
{
    <div class="alert alert-danger">@ViewData["MSG_E"]</div>
}

<form asp-action="EditarPerfil" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="card p-3 mb-3">
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="DataNasc"></label>
                <input asp-for="DataNasc" type="date" value="@(Model.DataNasc.HasValue ? Model.DataNasc.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
                <span asp-validation-for="DataNasc" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Sexo"></label>
                <select asp-for="Sexo" class="form-control">
                    <option value="M">Masculino</option>
                    <option value="F">Feminino</option>
                </select>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" type="text" class="form-control" placeholder="11999999999" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="CPF"></label>
                <input asp-for="CPF" class="form-control" />
                <span asp-validation-for="CPF" class="text-danger"></span>
            </div>
        </div>
    </div>

    <a asp-action="Perfil" class="btn btn-light rounded-pill">Cancelar</a>
    <button type="submit" class="btn btn-warning rounded-pill">Salvar</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}