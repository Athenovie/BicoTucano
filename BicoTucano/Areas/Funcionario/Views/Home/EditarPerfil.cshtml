@model BicoTucano.Models.Funcionario

@{
    ViewBag.Title = "Modificar Perfil";
}

<link rel="stylesheet" href="~/css/EditarPerfilFuncionario.css" />

<div class="editar-perfil-funcionario">
    <h1>MODIFICAR PERFIL</h1>

    @if (ViewData["MSG_E"] != null)
    {
        <div class="editar-perfil-aviso">@ViewData["MSG_E"]</div>
    }

    <form asp-action="EditarPerfil" method="post">
        <div asp-validation-summary="ModelOnly" class="editar-perfil-erros"></div>

        <section class="editar-perfil-cartao">
            <div class="editar-perfil-campos">
                <div class="editar-perfil-campo">
                    <label asp-for="Nome"></label>
                    <input asp-for="Nome" />
                    <span asp-validation-for="Nome" class="editar-perfil-erro"></span>
                </div>

                <div class="editar-perfil-campo">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" />
                    <span asp-validation-for="Email" class="editar-perfil-erro"></span>
                </div>

                <div class="editar-perfil-campo">
                    <label asp-for="DataNasc"></label>
                    <input asp-for="DataNasc" type="date"
                           value="@(Model.DataNasc.HasValue ? Model.DataNasc.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="DataNasc" class="editar-perfil-erro"></span>
                </div>

                <div class="editar-perfil-campo">
                    <label asp-for="Sexo"></label>
                    <select asp-for="Sexo">
                        <option value="M">Masculino</option>
                        <option value="F">Feminino</option>
                    </select>
                    <span asp-validation-for="Sexo" class="editar-perfil-erro"></span>
                </div>

                <div class="editar-perfil-campo">
                    <label asp-for="Telefone"></label>
                    <input asp-for="Telefone" type="text" placeholder="11999999999" />
                    <span asp-validation-for="Telefone" class="editar-perfil-erro"></span>
                </div>

                <div class="editar-perfil-campo">
                    <label asp-for="CPF"></label>
                    <input asp-for="CPF" />
                    <span asp-validation-for="CPF" class="editar-perfil-erro"></span>
                </div>
            </div>
        </section>

        <div class="editar-perfil-acoes">
            <a asp-action="Perfil" class="editar-perfil-cancelar">Cancelar</a>
            <button type="submit" class="editar-perfil-salvar">Salvar</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
