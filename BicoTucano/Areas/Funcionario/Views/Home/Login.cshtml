@model BicoTucano.Models.Funcionario
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login do Funcionário | Bico Tucano</title>

    <link rel="stylesheet" href="~/css/LoginFuncionario.css" asp-append-version="true" />
</head>
<body class="corpo-login">

    <div class="container-login">

<!--painel verde-->
    <div class="painel-verde">
         <div class="painel-verde-conteudo">
                <h1>Bem-vindo(a) <br><span>de volta!</span></h1>
              <p>Entre na sua conta.</p>
         </div>
    </div>

  <!--formulario-->
    <div class="area-formulario">
         <form class="formulario-login" asp-action="Login" method="post">

         <h2>Entrar</h2>
         <p class="subtitulo">Acesse sua conta para continuar</p>

     @if (ViewData["MSG_E"] != null)
         {
            <p class="aviso aviso-erro">@Html.Raw(ViewData["MSG_E"])</p>
         }
    <!--Campos da Área Formulário-->
     <div class="campo-formulario">
         <label asp-for="Email">Email</label>
         <input asp-for="Email" type="email" id="email" placeholder="Digite aqui seu email" />
         <span asp-validation-for="Email" class="texto-erro"></span>
     </div>

     <div class="campo-formulario">
         <label asp-for="Senha">Senha</label>
         <input asp-for="Senha" type="password" id="senha" placeholder="Digite aqui sua senha" />
         <span asp-validation-for="Senha" class="texto-erro"></span>
         <a class="link-esquecisenha" href="#">Esqueci a senha</a>
     </div>
<!--Botão-->
     <button type="submit" class="botao-entrar">Entrar</button>
         </form>
     </div>
  </div>

 </body>
</html>







