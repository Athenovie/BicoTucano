@model BicoTucano.Models.Funcionario

@{
    ViewBag.Title = "Meu Perfil";
    ViewData["SemBusca"] = true;

    string tel = Model.Telefone.HasValue ? Model.Telefone.Value.ToString("0") : "";
    if (tel.Length == 11)
        tel = "(" + tel.Substring(0, 2) + ") " + tel.Substring(2, 5) + "-" + tel.Substring(7);

    string cpf = Model.CPF ?? "";
    if (cpf.Length == 11)
        cpf = cpf.Substring(0, 3) + "." + cpf.Substring(3, 3) + "." + cpf.Substring(6, 3) + "-" + cpf.Substring(9);
}

<h2>MEU PERFIL</h2>

@if (TempData["MSG_S"] != null)
{
    <div class="alert alert-success">@TempData["MSG_S"]</div>
}

<section class="perfil-cartao">
    <div class="perfil-cartao-cabecalho">
        <h3 class="perfil-cartao-titulo">Dados pessoais</h3>
        <a class="perfil-cartao-link" asp-action="EditarPerfil">Modificar</a>
    </div>

    <div class="perfil-campos">
        <div>
            <span class="perfil-campo-nome">Nome</span>
            <span class="perfil-campo-valor">@Model.Nome</span>
        </div>
        <div>
            <span class="perfil-campo-nome">Data de Nascimento</span>
            <span class="perfil-campo-valor">@Model.DataNasc?.ToString("dd/MM/yyyy")</span>
        </div>
        <div>
            <span class="perfil-campo-nome">Telefone</span>
            <span class="perfil-campo-valor">@tel</span>
        </div>
        <div>
            <span class="perfil-campo-nome">CPF</span>
            <span class="perfil-campo-valor">@cpf</span>
        </div>
    </div>
</section>

<section class="perfil-cartao">
    <div class="perfil-cartao-cabecalho">
        <h3 class="perfil-cartao-titulo">Endereço</h3>
        <a class="perfil-cartao-link" href="#">Modificar</a>
    </div>

    <div class="perfil-campos">
