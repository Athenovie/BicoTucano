@using BicoTucano.Models.Constants
@inject BicoTucano.Libraries.Login.LoginFuncionario _funcionario


<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
    <meta name="generator" content="Jekyll v3.8.5">
    <title>@ViewBag.Title</title>

  

    <!-- Bootstrap core CSS -->
    <link rel="stylesheet" href="~/resources/lib/bootstrap-4.2.1-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/resources/lib/pagedlist/PagedList.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/css/Painel.css">
    <link rel="stylesheet" href="~/css/Tipografia.css" asp-append-version="true" />


    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />

    @*  <link href="~/resources/lib/pagedlist/PagedList.css" rel="stylesheet" type="text/css" /> *@

    <style>
            .bd-placeholder-img {
                font-size: 1.125rem;
                text-anchor: middle;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

            @@media (min-width: 768px) {
                .bd-placeholder-img-lg {
                    font-size: 3.5rem;
                }
            }
    </style>
    <!-- Custom styles for this template -->
    <link href="~/resources/lib/dashboard/dashboard.css" rel="stylesheet">
</head>
<body>
    <!--Adicionando Menu Lateral do Painel Admin-->
    <div class="menu-lateral">

        <h6>PAINEL ADMIN</h6>

        <nav>
            <a asp-area="Funcionario" asp-controller="Home" asp-action="Painel">
                <span>▦</span> DASHBOARD
            </a>

            <a asp-area="Funcionario" asp-controller="Home" asp-action="Perfil">
                <span>♟</span> PERFIL
            </a>

            <a asp-area="Funcionario" asp-controller="Produto" asp-action="Index">
                <span>🌱</span> PRODUTOS
            </a>

            @if (_funcionario.GetFuncionario() != null &&
                 _funcionario.GetFuncionario().NivelAcesso == BicoTucano.Models.NivelAcesso.Administrador)
            {
                <a asp-area="Funcionario" asp-controller="Home" asp-action="Index">
                    <span>♙</span> FUNCIONÁRIOS
                </a>
            }

            <a asp-area="Funcionario" asp-controller="Cliente" asp-action="Index">
                <span>♙</span> CLIENTES
            </a>

            <a asp-area="Funcionario" asp-controller="Pedido" asp-action="Index">
                <span>📦</span> PEDIDOS
            </a>

            <a asp-area="Funcionario" asp-controller="Home" asp-action="Logout" class="sair">
                <span>⇥</span> SAIR
            </a>
        </nav>

    </div>

    <main class="conteudo">
        @*O Layout só mostra a barra de pesquisa se SemBusca estiver vazia*@
        @if (ViewData["SemBusca"] == null)
        {
            <div class="barra-pesquisa">
                <input type="text" id="pesquisa" placeholder="@(ViewData["PlaceholderBusca"] ?? "⌕  Buscar por nome, email ou CPF...")">
            </div>
        }
        <!--RenderBody(): método do Bootstrap que organiza o conteúdo da página-->
                @RenderBody()

            </main>
        </div>
    </div>

   
    <script src="~/resources/lib/jquery3.3.1/jquery-3.3.1.min.js"></script>
    <script>window.jQuery || document.write('<script src="/resources/lib/jquery3.3.1/jquery-3.3.1.min.js"><\/script>')</script>
    <script src="~/resources/lib/mask/jquery.mask.min.js"></script>
    <script src="~/resources/lib/bootstrap-4.2.1-dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/resources/lib/feather/feather.js"></script>
    <script src="~/resources/lib/charts/charts.js"></script>
    <script src="~/resources/lib/dashboard/dashboard.js"></script>
    

    @RenderSection("Scripts", required: false)
</body>
</html>