@model BicoTucano.Models.PedidoAdmin.PedidoDetalhe
@using BicoTucano.Models

@{
    ViewBag.Title = "Detalhes do Pedido";
    var pt = new System.Globalization.CultureInfo("pt-BR");
    var pedido = Model.Pedido;

    string texto = "Em preparo";
    string cor = "#e8845c";

    if (pedido.StatusPedido == StatusPedido.EmEntrega)
    {
        texto = "Em entrega";
        cor = "#f0b429";
    }
    else if (pedido.StatusPedido == StatusPedido.Concluido)
    {
        texto = "Concluído";
        cor = "#8fbc94";
    }
}

<link rel="stylesheet" href="~/css/DetalhesPedidoFuncionario.css" />

<div class="detalhes-pedido-funcionario">
    @if (TempData["MSG_S"] != null)
    {
        <div class="detalhes-pedido-aviso detalhes-pedido-sucesso">@TempData["MSG_S"]</div>
    }
    @if (TempData["MSG_E"] != null)
    {
        <div class="detalhes-pedido-aviso detalhes-pedido-erro">@TempData["MSG_E"]</div>
    }

    <header class="detalhes-pedido-cabecalho">
        <h1>
            DETALHES DO PEDIDO #@pedido.NF
            <span class="detalhes-pedido-status" style="background-color:@cor">@texto</span>
        </h1>

        <form asp-action="AlterarStatus" method="post" class="detalhes-pedido-form-status">
            <input type="hidden" name="id" value="@pedido.NF" />
            <select name="status">
                <option value="1" selected="@(pedido.StatusPedido == StatusPedido.EmPreparo)">Em preparo</option>
                <option value="2" selected="@(pedido.StatusPedido == StatusPedido.EmEntrega)">Em entrega</option>
                <option value="3" selected="@(pedido.StatusPedido == StatusPedido.Concluido)">Concluído</option>
            </select>
            <button type="submit">Alterar Status</button>
        </form>
    </header>

    <div class="detalhes-pedido-layout">
        <div class="detalhes-pedido-coluna-principal">
            <section class="detalhes-pedido-cartao">
                <h2>Itens do pedido</h2>
                <div class="detalhes-pedido-tabela-wrapper">
                    <table class="detalhes-pedido-tabela">
                        <thead>
                            <tr>
                                <th>PRODUTO</th>
                                <th class="alinhamento-centro">QTD</th>
                                <th class="alinhamento-direita">UNITÁRIO</th>
                                <th class="alinhamento-direita">SUBTOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td>@item.Produto</td>
                                    <td class="alinhamento-centro">@item.Quantidade</td>
                                    <td class="alinhamento-direita">R$ @item.Preco.ToString("N2", pt)</td>
                                    <td class="alinhamento-direita"><strong>R$ @item.Subtotal.ToString("N2", pt)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="detalhes-pedido-cartao">
                <h2>Dados do cliente</h2>
                <div class="detalhes-pedido-dados">
                    <div><span>NOME</span><p>@Model.NomeCliente</p></div>
                    <div><span>EMAIL</span><p>@Model.Email</p></div>
                    <div><span>TELEFONE</span><p>@Model.Telefone</p></div>
                    <div><span>CPF</span><p>@Model.CPF</p></div>
                </div>
            </section>

            <section class="detalhes-pedido-cartao">
                <h2>Endereço de entrega</h2>

                @if (pedido.TipoPedido == TipoPedido.Entrega)
                {
                    <div class="detalhes-pedido-dados">
                        <div><span>LOGRADOURO</span><p>@Model.Logradouro</p></div>
                        <div><span>BAIRRO</span><p>@Model.Bairro</p></div>
                        <div><span>CEP</span><p>@Model.CEP</p></div>
                        <div><span>CIDADE / UF</span><p>@Model.CidadeUF</p></div>
                    </div>

                    @if (!string.IsNullOrEmpty(pedido.DetalhesPedido))
                    {
                        <div class="detalhes-pedido-observacao">
                            <span>NÚMERO / COMPLEMENTO / OBSERVAÇÃO</span>
                            <p>@pedido.DetalhesPedido</p>
                        </div>
                    }
                }
                else
                {
                    <p class="detalhes-pedido-retirada">Pedido para <strong>retirada</strong> na loja.</p>

                    @if (!string.IsNullOrEmpty(pedido.DetalhesPedido))
                    {
                        <div class="detalhes-pedido-observacao">
                            <span>OBSERVAÇÃO</span>
                            <p>@pedido.DetalhesPedido</p>
                        </div>
                    }
                }
            </section>
        </div>

        <aside class="detalhes-pedido-resumo">
            <section class="detalhes-pedido-cartao">
                <h2>Resumo financeiro</h2>

                <div class="detalhes-pedido-linha-resumo">
                    <span>Subtotal</span>
                    <strong>R$ @pedido.Subtotal.ToString("N2", pt)</strong>
                </div>
                <div class="detalhes-pedido-linha-resumo">
                    <span>Taxa de entrega</span>
                    <strong>R$ @pedido.TaxaEntrega.ToString("N2", pt)</strong>
                </div>

                <div class="detalhes-pedido-total">
                    <span>Total</span>
                    <strong>R$ @pedido.ValorTotal.ToString("N2", pt)</strong>
                </div>

                <div class="detalhes-pedido-linha-resumo">
                    <span>Método</span>
                    <strong>@Model.MetodoPagamento</strong>
                </div>
                <div class="detalhes-pedido-linha-resumo">
                    <span>Data</span>
                    <strong>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </section>
        </aside>
    </div>

    <a asp-action="Index" class="detalhes-pedido-voltar">Voltar</a>
</div>
