@model BicoTucano.Models.PedidoAdmin.PedidoDetalhe
@using BicoTucano.Models

@{
    ViewBag.Title = "Detalhes do Pedido";
    var pt = new System.Globalization.CultureInfo("pt-BR");
    var pedido = Model.Pedido;

    string texto = "Em preparo";
    string cor = "#e8845c";

    if (pedido.StatusPedido == StatusPedido.EmEntrega)
    {
        texto = "Em entrega";
        cor = "#f0b429";
    }
    else if (pedido.StatusPedido == StatusPedido.Concluido)
    {
        texto = "Concluído";
        cor = "#8fbc94";
    }
}

@if (TempData["MSG_S"] != null)
{
    <div class="alert alert-success">@TempData["MSG_S"]</div>
}
@if (TempData["MSG_E"] != null)
{
    <div class="alert alert-danger">@TempData["MSG_E"]</div>
}

<!-- Título + alterar status -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>
        DETALHES DO PEDIDO #@pedido.NF
        <span class="badge badge-pill text-white" style="background:@cor; font-size:0.9rem;">@texto</span>
    </h1>

    <form asp-action="AlterarStatus" method="post" class="form-inline">
        <input type="hidden" name="id" value="@pedido.NF" />
        <select name="status" class="form-control form-control-sm mr-2">
            <option value="1" selected="@(pedido.StatusPedido == StatusPedido.EmPreparo)">Em preparo</option>
            <option value="2" selected="@(pedido.StatusPedido == StatusPedido.EmEntrega)">Em entrega</option>
            <option value="3" selected="@(pedido.StatusPedido == StatusPedido.Concluido)">Concluído</option>
        </select>
        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">Alterar Status</button>
    </form>
</div>

<div class="row">

    <!-- Coluna esquerda -->
    <div class="col-md-8">

        <!-- Itens do pedido -->
        <div class="card p-3 mb-3">
            <h5>Itens do pedido</h5>
            <table class="table table-borderless mb-0">
                <thead>
                    <tr style="color:#4a7c59; border-bottom:1px solid #8fbc94;">
                        <th>PRODUTO</th>
                        <th class="text-center">QTD</th>
                        <th class="text-right">UNITÁRIO</th>
                        <th class="text-right">SUBTOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>@item.Produto</td>
                            <td class="text-center">@item.Quantidade</td>
                            <td class="text-right">R$ @item.Preco.ToString("N2", pt)</td>
                            <td class="text-right"><strong>R$ @item.Subtotal.ToString("N2", pt)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Dados do cliente -->
        <div class="card p-3 mb-3">
            <h5>Dados do cliente</h5>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <small style="color:#4a7c59;"><strong>NOME</strong></small><br />
                    @Model.NomeCliente
                </div>
                <div class="col-md-6 mb-2">
                    <small style="color:#4a7c59;"><strong>EMAIL</strong></small><br />
                    @Model.Email
                </div>
                <div class="col-md-6">
                    <small style="color:#4a7c59;"><strong>TELEFONE</strong></small><br />
                    @Model.Telefone
                </div>
                <div class="col-md-6">
                    <small style="color:#4a7c59;"><strong>CPF</strong></small><br />
                    @Model.CPF
                </div>
            </div>
        </div>

        <!-- Endereço de entrega -->
        <div class="card p-3 mb-3">
            <h5>Endereço de entrega</h5>

            @if (pedido.TipoPedido == TipoPedido.Entrega)
            {
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <small style="color:#4a7c59;"><strong>LOGRADOURO</strong></small><br />
                        @Model.Logradouro
                    </div>
                    <div class="col-md-6 mb-2">
                        <small style="color:#4a7c59;"><strong>BAIRRO</strong></small><br />
                        @Model.Bairro
                    </div>
                    <div class="col-md-6">
                        <small style="color:#4a7c59;"><strong>CEP</strong></small><br />
                        @Model.CEP
                    </div>
                    <div class="col-md-6">
                        <small style="color:#4a7c59;"><strong>CIDADE / UF</strong></small><br />
                        @Model.CidadeUF
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(pedido.DetalhesPedido))
                {
                    <div class="mt-3">
                        <small style="color:#4a7c59;"><strong>NÚMERO / COMPLEMENTO / OBSERVAÇÃO</strong></small><br />
                        @pedido.DetalhesPedido
                    </div>
                }
            }
            else
            {
                <p class="mb-0">Pedido para <strong>retirada</strong> na loja.</p>

                @if (!string.IsNullOrEmpty(pedido.DetalhesPedido))
                {
                    <div class="mt-3">
                        <small style="color:#4a7c59;"><strong>OBSERVAÇÃO</strong></small><br />
                        @pedido.DetalhesPedido
                    </div>
                }
            }
        </div>

    </div>

    <!-- Coluna direita: resumo financeiro -->
    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h5>Resumo financeiro</h5>

            <div class="d-flex justify-content-between">
                <span class="text-muted">Subtotal</span>
                <strong style="color:#4a7c59;">R$ @pedido.Subtotal.ToString("N2", pt)</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span class="text-muted">Taxa de entrega</span>
                <strong style="color:#4a7c59;">R$ @pedido.TaxaEntrega.ToString("N2", pt)</strong>
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <strong>Total</strong>
                <strong>R$ @pedido.ValorTotal.ToString("N2", pt)</strong>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <span class="text-muted">Método</span>
                <strong style="color:#4a7c59;">@Model.MetodoPagamento</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span class="text-muted">Data</span>
                <strong style="color:#4a7c59;">@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
        </div>
    </div>

</div>

<a asp-action="Index" class="btn btn-light rounded-pill">Voltar</a>