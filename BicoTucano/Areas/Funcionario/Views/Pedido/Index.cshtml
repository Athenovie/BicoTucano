@model IEnumerable<BicoTucano.Models.PedidoAdmin.PedidoLista>
@using BicoTucano.Models

@{
    ViewBag.Title = "Pedidos";
    var pt = new System.Globalization.CultureInfo("pt-BR");
}

<div class="pedidos">

    <h1>PEDIDOS</h1>

    <div class="tabela-pedidos">

        <table id="tabelaPedidos">
            <thead>
                <tr>
                    <th>Nº DO PEDIDO</th>
                    <th>PRODUTO(S)</th>
                    <th>VALOR</th>
                    <th>DATA</th>
                    <th>CLIENTE</th>
                    <th>STATUS</th>
                    <th></th>
                 </tr>
           </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    string texto = "Em preparo";
                    string classe = "preparo";

                    if (p.StatusPedido == StatusPedido.EmEntrega)
                    {
                        texto = "Em entrega";
                        classe = "entrega";
                    }
                    else if (p.StatusPedido == StatusPedido.Concluido)
                    {
                        texto = "Concluído";
                        classe = "concluido";
                    }

                    <tr data-busca="@p.Email @p.CPF">
                        <td>@p.NF</td>

                        <td>
                            @foreach (var produto in p.Produtos.Split('|'))
                            {
                                <div>@produto</div>
                            }
                        </td>

                        <td>R$ @p.ValorTotal.ToString("N2", pt)</td>

                        <td>@p.DataPedido.ToString("dd/MM/yyyy")</td>

                        <td>@p.Cliente</td>
                        <td>
                            <span class="status @classe">
                                @texto
                            </span>
                        </td>

                        <td>
                            <a class="detalhes"
                               asp-action="Detalhes"
                               asp-route-id="@p.NF">
                                DETALHES
                            </a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>
